{
  "name": "mtg-history",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "screenshots:readme": "playwright test --config playwright.readme.config.mjs",
    "astro": "astro",
    "test": "node --test scripts/*.test.mjs",
    "check:links": "node scripts/check-built-links.mjs",
    "check:content": "node --experimental-strip-types scripts/check-content-graph.mjs",
    "migrate:cards": "node scripts/migrate-cards-to-collections.mjs",
    "migrate:card-consumers": "node scripts/migrate-card-consumers.mjs",
    "check:cards": "node scripts/check-card-collections.mjs",
    "migrate:entities": "node --experimental-strip-types scripts/migrate-entities-to-collections.mjs",
    "check:entities": "node --experimental-strip-types scripts/check-entity-collections.mjs",
    "check:editorial": "node scripts/check-editorial-metadata.mjs",
    "check:provenance": "node scripts/check-event-provenance.mjs",
    "audit:history": "node scripts/audit-historical-risk.mjs",
    "audit:provenance": "node scripts/audit-external-provenance.mjs",
    "check:artwork": "node scripts/check-artwork-fidelity.mjs",
    "review:artwork": "node scripts/check-artwork-fidelity.mjs",
    "verify": "pnpm run test && pnpm run check:entities && pnpm run check:cards && pnpm run check:content && pnpm run check:editorial && pnpm run check:provenance && pnpm run check:artwork && pnpm run check:images && pnpm run check:styles && pnpm run check:themes && pnpm run check:glossary && pnpm run check:types && pnpm run build && pnpm run check:links",
    "check:types": "astro check",
    "check:styles": "node scripts/check-style-architecture.mjs",
    "check:themes": "node scripts/check-chapter-themes.mjs",
    "check:glossary": "node scripts/check-glossary.mjs",
    "check:images": "node scripts/check-image-assets.mjs",
    "probe:images": "node scripts/probe-card-images.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/mdx": "^8.0.3",
    "@egjs/hammerjs": "2.0.17",
    "astro": "^7.3.8",
    "component-emitter": "1.3.1",
    "keycharm": "0.4.0",
    "uuid": "14.0.1",
    "vis-data": "8.0.4",
    "vis-network": "10.1.2",
    "vis-util": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "typescript": "5.9.3",
    "sass": "1.105.2"
  }
}
