---
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource-variable/source-sans-3/wght-italic.css';
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';
import '../styles/global.scss';
import SiteHeader from '../components/SiteHeader.astro';
import atmosphereSource from '../assets/phase15-atmosphere.jpg';
import SiteFooter from '../components/SiteFooter.astro';
import CardArtworkViewer from '../components/CardArtworkViewer.astro';
import { withBase } from '../utils/paths';
import { routeAlternates, uiFor } from '../utils/i18n.mjs';

interface Props {
  title: string;
  description: string;
  locale?: 'en' | 'pt-BR';
  printingId?: string;
}
const { title, description, locale = 'en', printingId } = Astro.props;
const atmosphere = atmosphereSource;
const ui = uiFor(locale);
const alternates = routeAlternates(Astro.url.pathname, Astro.site, withBase(''));
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialTitle = `${title} | Chronicles of the Multiverse`;
const socialImage = new URL(withBase('social-preview.png'), Astro.site).href;
const socialImageAlt = 'Chronicles of the Multiverse: a golden celestial compass on a dark star map';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

<script is:inline>
  (() => {
    const key = 'mtg-history-theme';
    let savedTheme = null;

    try {
      savedTheme = localStorage.getItem(key);
    } catch {
      // Browser storage may be unavailable.
    }

    const systemPrefersDark = window.matchMedia(
      '(prefers-color-scheme: dark)'
    ).matches;

    const theme =
      savedTheme === 'dark' || savedTheme === 'light'
        ? savedTheme
        : systemPrefersDark
          ? 'dark'
          : 'light';

    document.documentElement.dataset.theme = theme;
  })();
</script>

    <meta name="theme-color" content="#11191d" />
    <meta name="description" content={description} />
    {printingId && <meta name="archive-printing" content={printingId} data-pagefind-meta="printingId[content]" />}
    <link rel="canonical" href={canonical} />
    {alternates.map(({ lang, href }) => <link rel="alternate" hreflang={lang} href={href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chronicles of the Multiverse" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <title>{title} | Chronicles of the Multiverse</title>
  </head>
  <body class="editorial-design" style={`--site-atmosphere: url("${atmosphere.src}")`}>
    <a class="skip-link" href="#main-content">{ui.skip}</a>
    <SiteHeader locale={locale} />
    <main id="main-content" data-pagefind-body><slot /></main>
    <SiteFooter locale={locale} />
    <CardArtworkViewer />
    <script>
      import '../scripts/card-image-fallback';
    </script>
  </body>
</html>
