---
import { localeForPath, localPath, phrase } from '../utils/locale';

import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  chapters: CollectionEntry<'chapters' | 'chaptersPt'>[];
  activeId?: string;
}

const { chapters: providedChapters, activeId } = Astro.props;
const pageLocale = localeForPath(Astro.url.pathname);
const t = (english: string) => phrase(pageLocale, english);
const chapterTranslations = new Map((pageLocale === 'pt-BR' ? await getCollection('chaptersPt') : []).map(chapter => [chapter.id, chapter]));
const chapters = providedChapters.map(chapter => chapterTranslations.get(chapter.id) ?? chapter);

const orderedChapters = [...chapters].sort(
  (a, b) =>
    a.data.order - b.data.order ||
    a.id.localeCompare(b.id)
);
---

<nav
  class="chronology-strip"
  aria-label={t("Historical and publication chronology")}
>
  <div class="chronology-strip__heading">
    <p class="eyebrow">{t("The historical record")}</p>
    <h2>{t("Two histories. One Multiverse.")}</h2>
    <p>
      {t("Follow events in their fictional order, and discover when Magic published the stories behind them.")}
    </p>
  </div>

  <ol class="chronology-strip__entries">
    {orderedChapters.map((chapter) => (
      <li class="chronology-strip__entry">
        <a
          class:list={[
            'chronology-strip__link',
            activeId === chapter.id &&
              'chronology-strip__link--current',
          ]}
          href={localPath(`chapters/${chapter.id}/#chapter-reader`, pageLocale)}
          aria-current={
            activeId === chapter.id ? 'page' : undefined
          }
        >
          <span class="chronology-strip__number">
            {t('Chapter')} {String(chapter.data.order).padStart(2, '0')}
          </span>

          <strong class="chronology-strip__title">
            {chapter.data.title}
          </strong>

          <span class="chronology-strip__track">
            <span class="chronology-strip__label">
              {t("In-universe chronology")}
            </span>

            <span class="chronology-strip__date">
              {chapter.data.chronology.storyPeriod}
            </span>

            <span class="chronology-strip__detail">
              {chapter.data.chronology.storyDetail}
            </span>
          </span>

          <span class="chronology-strip__track chronology-strip__track--publication">
            <span class="chronology-strip__label">
              {t("Real-world publication")}
            </span>

            <span class="chronology-strip__publication">
              {chapter.data.chronology.publicationHistory}
            </span>
          </span>

          <span class="chronology-strip__action">
            {activeId === chapter.id
              ? t('Currently reading')
              : t('Explore chapter →')}
          </span>
        </a>
      </li>
    ))}
  </ol>

  <p class="chronology-strip__note">
    {t("AR = Argivian Reckoning, the Dominarian calendar beginning with the births of Urza and Mishra. Dates are an approximate editorial guide. Chapters are shown in reading order, not to scale.")}
  </p>
</nav>
