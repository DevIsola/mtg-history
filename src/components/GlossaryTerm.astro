---
import { localeForPath, localPath, phrase } from '../utils/locale';

import { getEntry } from 'astro:content';
import { localized } from '../utils/localization';

interface Props { id: string; }
const pageLocale = localeForPath(Astro.url.pathname);
const { id } = Astro.props;
const entry = await getEntry('glossary', id);
if (!entry) throw new Error(`Unknown glossary term: ${id}`);
// Web Crypto is available in the supported Node.js runtime and the DOM types.
const definition = localized('glossary', { id: entry.id, ...entry.data }, pageLocale);
const panelId = `lore-definition-${globalThis.crypto.randomUUID()}`;
const href = localPath(`glossary/#${entry.id}`, pageLocale);

const t = (english: string) => phrase(pageLocale, english);
---

<span class="lore-term" data-lore-term>
  <a href={href} class="lore-term__link"><slot>{definition.term}</slot></a>
  <button
    class="lore-term__button"
    type="button"
    data-lore-button
    aria-label={`${t('Explain')} ${definition.term}`}
    aria-controls={panelId}
    aria-expanded="false"
    hidden
  >?</button>
  <span
    class="lore-term__panel"
    id={panelId}
    data-lore-panel
    role="group"
    aria-label={`${t('Definition of')} ${definition.term}`}
    hidden
  >
    <strong class="lore-term__title">{definition.term}</strong>
    <span class="lore-term__description">{definition.summary}</span>
    <a class="lore-term__more" href={href}>{t("Full glossary entry →")}</a>
  </span>
</span>

<script>
  import { setupLoreTerms } from '../scripts/lore-terms';
  setupLoreTerms();
</script>

<style lang="scss">
  .lore-term { position: relative; display: inline; }
  .lore-term__link { color: var(--link-color); text-decoration: underline; text-underline-offset: 0.19em; }
  .lore-term__link:hover { color: var(--link-hover); }
  .lore-term__button { display: inline-flex; align-items: center; justify-content: center; margin-inline: 0.12em; padding: 0; width: 1.25em; height: 1.25em; border-radius: 50%; border: 1px solid var(--line); background: var(--paper-deep); color: var(--link-color); font: inherit; font-size: 0.72em; line-height: 1; cursor: pointer; vertical-align: middle; }
  .lore-term__button[hidden], .lore-term__panel[hidden] { display: none; }
  .lore-term__button:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
  .lore-term__panel { position: absolute; z-index: 70; display: block; left: 0; top: calc(100% + 0.35rem); width: min(20rem, calc(100vw - 2rem)); max-width: calc(100vw - 2rem); padding: 0.85rem 1rem; background: var(--paper-white); color: var(--ink); border: 1px solid var(--line); border-top: 3px solid var(--era-accent, var(--gold)); border-radius: 5px; box-shadow: 0 10px 30px #0004; font-family: var(--font-body); font-size: 0.85rem; line-height: 1.55; text-align: left; }
  .lore-term__title, .lore-term__description, .lore-term__more { display: block; }
  .lore-term__title { font-weight: 750; margin-bottom: 0.35rem; }
  .lore-term__description { color: var(--ink-soft); }
  .lore-term__more { margin-top: 0.6rem; font-size: 0.81rem; color: var(--link-color); text-decoration: underline; }
</style>
