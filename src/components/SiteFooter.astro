---
import { withBase } from '../utils/paths';
import { uiFor } from '../utils/i18n.mjs';
interface Props { locale?: 'en' | 'pt-BR'; }
const { locale = 'en' } = Astro.props;
const ui = uiFor(locale);
---
<footer class="site-footer">
  <div class="page-shell footer-grid">
    <div>
      <div class="footer-brand"><span aria-hidden="true">✦</span> Chronicles of the Multiverse</div>
      <p>{ui.footerIntro}</p>
    </div>
    <div class="footer-links">
      <a href={withBase('timeline/')}>{ui.footerLinks[0]}</a>
      <a href={withBase('glossary/')}>{ui.footerLinks[1]}</a>
      <a href={withBase('about/')}>{ui.footerLinks[2]}</a>
      <a href="https://github.com/DevIsola/mtg-history" target="_blank" rel="noopener noreferrer">GitHub ↗</a>

<a
  href="https://ko-fi.com/B1H328PBAR"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ui.supportAria}
>
  {ui.support}
</a>

    </div>
  </div>
  <div class="page-shell footer-legal">
    <p>{ui.legal}</p>
    <p>
  {ui.credit}&nbsp;
  <a
    href="https://github.com/DevIsola"
    target="_blank"
    rel="noopener noreferrer"
  >
    DevIsola ↗
  </a>
</p>
  </div>
</footer>

<style lang="scss">
  @use "../styles/breakpoints" as bp;

  .site-footer {
    background: var(--night);
    color: #d9d3c5;
    padding-block: 4.5rem 2rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
  }
  .footer-brand {
    font-family: var(--font-display);
    font-size: 1.4rem;
  }
  .footer-brand span {
    color: var(--gold-light);
    margin-right: 0.55rem;
  }
  .footer-grid p {
    margin-top: 0.9rem;
    max-width: 440px;
    line-height: 1.7;
    color: #a9b5af;
    font-size: 0.86rem;
  }
  .footer-links {
    display: flex;
    gap: 1.6rem;
    align-items: start;
    padding-top: 0.35rem;
  }
  .footer-links a {
    text-decoration: none;
    font-size: 0.78rem;
  }
  .footer-links a:hover {
    color: var(--gold-light);
  }
  .footer-legal {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    border-top: 1px solid #48534b;
    margin-top: 4rem;
    padding-top: 1.6rem;
  }
  .footer-legal p {
    font-size: 0.68rem;
    line-height: 1.7;
    color: #97a69d;
    max-width: 670px;
  }

  @media (max-width: bp.$header) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-links {
      flex-wrap: wrap;
    }
    .footer-legal {
      display: block;
    }
    .footer-legal p + p {
      margin-top: 1rem;
    }
  }
</style>
