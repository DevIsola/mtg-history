---
import { localeForPath, localPath, phrase } from '../utils/locale';
interface Props { locale?: 'en' | 'pt-BR'; }
const { locale = localeForPath(Astro.url.pathname) } = Astro.props;
const pageLocale = locale;
const t = (english: string) => phrase(pageLocale, english);
---
<footer class="site-footer">
  <div class="page-shell footer-grid">
    <div>
      <div class="footer-brand"><span aria-hidden="true">✦</span> {t("Chronicles of the Multiverse")}</div>
      <p>{t('An independent historical guide to the stories behind Magic: The Gathering.')}</p>
    </div>
    <div class="footer-links">
      <a href={localPath('timeline/', locale)}>{t('Timeline')}</a>
      <a href={localPath('glossary/', locale)}>{t('Lore glossary')}</a>
      <a href={localPath('about/', locale)}>{t('About this project')}</a>
      <a href="https://github.com/DevIsola/mtg-history" target="_blank" rel="noopener noreferrer">GitHub ↗</a>

<a
  href="https://ko-fi.com/B1H328PBAR"
  target="_blank"
  rel="noopener noreferrer"
>
  {t('Support on Ko-fi ↗')}
</a>

    </div>
  </div>
  <div class="page-shell footer-legal">
    <div><p>{t('This is unofficial fan content, not approved or endorsed by Wizards of the Coast. Magic: The Gathering and related marks belong to Wizards of the Coast.')}</p><p class="footer-artwork"><a href={localPath('about/#site-illustration', locale)}>{t('About the decorative landscape')}</a></p></div>
    <p>
  {t('Created and maintained with love 🖤 by')}&nbsp;
  <a
    href="https://github.com/DevIsola"
    target="_blank"
    rel="noopener noreferrer"
  >
    DevIsola ↗
  </a>
</p>
  </div>
</footer>

<style lang="scss">
  @use "../styles/breakpoints" as bp;

  .site-footer {
    background: var(--night);
    color: #d9d3c5;
    padding-block: 4.5rem 2rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
  }
  .footer-brand {
    font-family: var(--font-display);
    font-size: 1.4rem;
  }
  .footer-brand span {
    color: var(--gold-light);
    margin-right: 0.55rem;
  }
  .footer-grid p {
    margin-top: 0.9rem;
    max-width: 440px;
    line-height: 1.7;
    color: #a9b5af;
    font-size: 0.86rem;
  }
  .footer-links {
    display: flex;
    gap: 1.6rem;
    align-items: start;
    padding-top: 0.35rem;
  }
  .footer-links a {
    text-decoration: none;
    font-size: 0.78rem;
  }
  .footer-links a:hover {
    color: var(--gold-light);
  }
  .footer-legal {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    border-top: 1px solid #48534b;
    margin-top: 4rem;
    padding-top: 1.6rem;
  }
  .footer-legal p {
    font-size: 0.75rem;
    line-height: 1.7;
    color: #97a69d;
    max-width: 670px;
  }

  @media (max-width: bp.$header) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .footer-links {
      flex-wrap: wrap;
    }
    .footer-legal {
      display: block;
    }
    .footer-legal p + p {
      margin-top: 1rem;
    }
  }
</style>
