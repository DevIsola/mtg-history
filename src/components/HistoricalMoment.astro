---
import HistoricalCard from './HistoricalCard.astro';
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

type Card = CollectionEntry<'chapters'>['data']['cards'][number];

interface Props {
  card: Card;
}

const { card } = Astro.props;
const printing = await getEntry('cards', card.scryfallId);
if (!printing) throw new Error(`Missing canonical card ${card.scryfallId}`);
---

<aside class="historical-moment" aria-label={'Historical illustration: ' + printing.data.name}>
  <div class="historical-moment__copy">
    <p class="historical-moment__eyebrow">
      <span aria-hidden="true">✦</span>
      From the illustrated archive
    </p>
    <div class="historical-moment__narrative">
      <slot />
    </div>
  </div>

  <div class="historical-moment__illustration">
    <HistoricalCard card={card} />
  </div>
</aside>
