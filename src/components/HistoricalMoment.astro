---
import HistoricalCard from './HistoricalCard.astro';
import { getEntry } from 'astro:content';
interface Props {
  cardId: string | { id: string; collection: 'cards' };
  significance: string;
}

const { cardId, significance } = Astro.props;
const id = typeof cardId === 'string' ? cardId : cardId.id;
const printing = await getEntry('cards', id);
if (!printing) throw new Error(`Missing canonical card ${id}`);
---

<aside class="historical-moment" aria-label={'Historical illustration: ' + printing.data.name}>
  <div class="historical-moment__copy">
    <p class="historical-moment__eyebrow">
      <span aria-hidden="true">✦</span>
      From the illustrated archive
    </p>
    <div class="historical-moment__narrative">
      <slot />
    </div>
  </div>

  <div class="historical-moment__illustration">
    <HistoricalCard card={{ scryfallId: printing.id, significance }} compact />
  </div>
</aside>
