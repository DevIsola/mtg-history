---
import { getEntry } from 'astro:content';
import { archiveCard } from '../utils/card-localization';
import { localeForPath } from '../utils/locale';

interface Props {
  name: string;
  cardId: string;
}

const { name, cardId } = Astro.props;
const printing = await getEntry('cards', cardId);
if (!printing) throw new Error(`Missing canonical card ${cardId}`);
const locale = localeForPath(Astro.url.pathname);
const pt = locale === 'pt-BR';
const card = archiveCard({ ...printing.data, scryfallId: printing.id }, locale);
const imageUrl = card.imageUrl;
const imageSrcset = card.imageSrcset;
---

<span
  class="card-hover"
  data-card-preview
  data-canonical-id={printing.id}
  data-displayed-id={card.printingId}
  data-language={card.language}
  data-card-original-source={card.originalUrl}
  data-card-image={imageUrl}
  data-card-image-set={imageSrcset}
  data-card-name={card.name}
  data-card-artist={card.artist}
  data-card-set={card.setCode.toUpperCase()}
>
  <slot />
  <button
    class="card-hover__button"
    type="button"
    data-card-preview-button
    aria-label={pt ? `Prévia da carta de Magic de ${name}` : `Preview ${name}'s Magic card`}
    aria-expanded="false"
    hidden
  >
    <span aria-hidden="true">◇</span>
  </button>
</span>

<style lang="scss">
  .card-hover {
    display: inline;
  }

  .card-hover__button {
    margin-left: 0.2em;
    padding: 0.05em 0.25em;
    border: 1px solid var(--gold);
    border-radius: 3px;
    background: transparent;
    color: var(--link-color);
    font: inherit;
    font-size: 0.8em;
    line-height: 1;
    vertical-align: middle;
    cursor: pointer;
  }

  .card-hover__button[hidden] {
    display: none;
  }

  .card-hover__button:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  @media (hover: hover) {
    .card-hover__button:not([hidden]) {
      display: none;
    }
  }

  @media (hover: none) {
    .card-hover__button:not([hidden]) {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>

<!-- The one floating preview is created in document.body so it cannot be clipped
     by chapter layouts, scroll containers, or surrounding paragraphs. -->
<style is:global>
  .card-hover-popover {
    position: fixed;
    z-index: 2000;
    box-sizing: border-box;
    width: min(240px, calc(100vw - 24px));
    max-height: calc(100dvh - 24px);
    padding: 9px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--paper-white);
    box-shadow: 0 16px 48px rgb(0 0 0 / 0.32);
    pointer-events: none;
  }

  .card-hover-popover[hidden] {
    display: none !important;
  }

  .card-hover-popover__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: calc(100dvh - 99px);
    object-fit: contain;
    border-radius: 7px;
  }

  .card-hover-popover__caption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.6rem 0.15rem 0.1rem;
    color: var(--ink);
    line-height: 1.35;
  }

  .card-hover-popover__caption strong {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: normal;
  }

  .card-hover-popover__caption span {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }
</style>

<script>
  // Astro bundles this script only once even when a chapter has many links.
  const pt = document.documentElement.lang === 'pt-BR';
  const previews = document.querySelectorAll<HTMLElement>('[data-card-preview]');

  if (previews.length > 0) {
    const popover = document.createElement('div');
    popover.id = 'character-card-hover-preview';
    popover.className = 'card-hover-popover';
    popover.setAttribute('role', 'tooltip');
    popover.hidden = true;

    const image = document.createElement('img');
    image.className = 'card-hover-popover__image';
    image.width = 488;
    image.height = 680;
    image.decoding = 'async';
    image.sizes = 'min(85vw, 300px)';

    const caption = document.createElement('div');
    caption.className = 'card-hover-popover__caption';

    const cardName = document.createElement('strong');
    const cardDetails = document.createElement('span');
    caption.append(cardName, cardDetails);
    popover.append(image, caption);
    document.body.append(popover);

    type DisplayMode = 'hover' | 'focus' | 'button';
    let activeLink: HTMLAnchorElement | null = null;
    let activeTrigger: HTMLElement | null = null;
    let activeButton: HTMLButtonElement | null = null;
    let activeMode: DisplayMode | null = null;
    let hoverTimer: number | undefined;

    const clamp = (value: number, min: number, max: number): number =>
      Math.max(min, Math.min(value, Math.max(min, max)));

    const closePreview = () => {
      window.clearTimeout(hoverTimer);
      hoverTimer = undefined;
      activeLink?.removeAttribute('aria-describedby');
      activeButton?.setAttribute('aria-expanded', 'false');
      popover.hidden = true;
      activeLink = null;
      activeTrigger = null;
      activeButton = null;
      activeMode = null;
    };

    const positionPreview = () => {
      if (!activeTrigger || popover.hidden) return;

      popover.style.visibility = 'hidden';

      const trigger = activeTrigger.getBoundingClientRect();
      const width = popover.offsetWidth;
      const height = popover.offsetHeight;
      const margin = 12;
      const gap = 12;
      const right = trigger.right + gap;
      const left = trigger.left - gap - width;
      const fitsRight = right + width + margin <= window.innerWidth;
      const fitsLeft = left >= margin;

      let x: number;
      let y: number;

      if (fitsRight) {
        x = right;
      } else if (fitsLeft) {
        x = left;
      } else {
        // Narrow viewports: center horizontally and prefer above/below.
        x = clamp(
          trigger.left + trigger.width / 2 - width / 2,
          margin,
          window.innerWidth - width - margin
        );
      }

      if (!fitsRight && !fitsLeft) {
        if (trigger.top >= height + gap + margin) {
          y = trigger.top - height - gap;
        } else if (
          trigger.bottom + height + gap + margin <= window.innerHeight
        ) {
          y = trigger.bottom + gap;
        } else {
          y = clamp(
            trigger.bottom + gap,
            margin,
            window.innerHeight - height - margin
          );
        }
      } else {
        y = clamp(
          trigger.top + trigger.height / 2 - height / 2,
          margin,
          window.innerHeight - height - margin
        );
      }

      popover.style.left = `${Math.round(x)}px`;
      popover.style.top = `${Math.round(y)}px`;
      popover.style.visibility = 'visible';
    };

    const openPreview = (
      wrapper: HTMLElement,
      link: HTMLAnchorElement,
      trigger: HTMLElement,
      mode: DisplayMode
    ) => {
      closePreview();

      activeLink = link;
      activeTrigger = trigger;
      activeButton = wrapper.querySelector<HTMLButtonElement>(
        '[data-card-preview-button]'
      );
      activeMode = mode;

      const name = wrapper.dataset.cardName ?? (pt ? 'Carta de Magic' : 'Magic card');
      // A previously failed card must not leave its placeholder in a new preview.
      image.parentElement?.querySelector('.card-image-fallback')?.remove();
      image.style.removeProperty('display');
      delete image.dataset.cardImageFallbackApplied;
      image.srcset = wrapper.dataset.cardImageSet ?? '';
      image.src = wrapper.dataset.cardImage ?? '';
      image.alt = `${pt ? 'Carta de Magic: The Gathering' : 'Magic: The Gathering card'}: ${name}`;
      cardName.textContent = name;
      cardDetails.textContent =
        `${wrapper.dataset.cardSet ?? ''} · ${pt ? 'Ilustração de' : 'Illustrated by'} ${wrapper.dataset.cardArtist ?? ''}${pt ? (wrapper.dataset.language === 'pt' ? ' · Carta oficial em português (PT)' : ' · Imagem da edição original (EN)') : ''}`;

      popover.hidden = false;
      positionPreview();

      if (mode === 'focus') {
        link.setAttribute('aria-describedby', popover.id);
      }
      if (mode === 'button') {
        activeButton?.setAttribute('aria-expanded', 'true');
      }
    };

    for (const wrapper of previews) {
      const link = wrapper.querySelector<HTMLAnchorElement>('a');
      const button = wrapper.querySelector<HTMLButtonElement>(
        '[data-card-preview-button]'
      );
      if (!link || !button) continue;

      // Without JavaScript the original link still works, but this button stays hidden.
      button.hidden = false;
      button.setAttribute('aria-controls', popover.id);

      link.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'touch') return;
        window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => {
          if (document.activeElement !== link) {
            openPreview(wrapper, link, link, 'hover');
          }
        }, 160);
      });

      link.addEventListener('pointerleave', () => {
        window.clearTimeout(hoverTimer);
        if (activeLink === link && activeMode === 'hover') {
          closePreview();
        }
      });

      link.addEventListener('focus', () => {
        openPreview(wrapper, link, link, 'focus');
      });

      link.addEventListener('blur', () => {
        if (activeLink === link && activeMode === 'focus') {
          closePreview();
        }
      });

      button.addEventListener('click', () => {
        if (activeButton === button && activeMode === 'button') {
          closePreview();
        } else {
          openPreview(wrapper, link, button, 'button');
        }
      });
    }

    document.addEventListener('pointerdown', (event) => {
      if (activeMode !== 'button') return;
      const target = event.target;
      if (
        target instanceof Node &&
        activeButton?.parentElement?.contains(target)
      ) {
        return;
      }
      closePreview();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !popover.hidden) {
        closePreview();
      }
    });

    window.addEventListener('resize', positionPreview);
    // Focusing, hovering, and tapping a trigger can scroll it into view.
    // Closing on every scroll immediately hides the preview and clears its
    // ARIA state. Reposition it instead; pointerleave, blur, outside taps,
    // and Escape already handle deliberate dismissal.
    window.addEventListener('scroll', positionPreview, {
      capture: true,
      passive: true,
    });
  }
</script>
