---
import { getCollection } from 'astro:content';
import { portugueseEra } from '../utils/pt-catalog.mjs';
interface Props { locale?: 'en' | 'pt-BR'; }
const { locale = 'en' } = Astro.props;
const pt = locale === 'pt-BR';
const chapters = (await getCollection('chapters')).sort((a, b) => a.data.order - b.data.order);
---
<nav class="archive-chapter-index" aria-label={pt ? 'Referências por capítulo' : 'Illustrations by chapter'}>
  {chapters.map(chapter => <a class="chapter-cover" href={'#' + chapter.id}>
    <span class="chapter-cover__number">{pt ? 'Capítulo' : 'Chapter'} {String(chapter.data.order).padStart(2, '0')}</span>
    <strong>{pt ? portugueseEra(chapter.id).name : chapter.data.title}</strong>
    <span>{chapter.data.cardIds.length} {pt ? 'referências ilustradas' : 'illustrated references'} →</span>
  </a>)}
</nav>
