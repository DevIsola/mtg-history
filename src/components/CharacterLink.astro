---
import { localeForPath, localPath } from '../utils/locale';

import { characters } from '../data/characters';
import { localized } from '../utils/localization';
import CardHoverPreview from './CardHoverPreview.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;

const canonicalCharacter = characters.find((entry) => entry.id === id);

if (!canonicalCharacter) {
  throw new Error(`Unknown historical character: ${id}`);
}

const pageLocale = localeForPath(Astro.url.pathname);
const character = localized('characters', canonicalCharacter, pageLocale);
---

<CardHoverPreview name={character.name} cardId={character.featuredCardId}>
  <a
    class="character-inline-link"
    href={localPath(`characters/${character.id}/`, pageLocale)}
  >
    <slot>{character.name}</slot>
  </a>
</CardHoverPreview>
