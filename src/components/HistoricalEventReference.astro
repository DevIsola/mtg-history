---
import { localeForPath, localPath, phrase } from '../utils/locale';

import { historicalEvents } from '../data/events';
import { localized } from '../utils/localization';

interface Props {
  id: string;
}

const pageLocale = localeForPath(Astro.url.pathname);
const t = (english: string) => phrase(pageLocale, english);

const { id } = Astro.props;

const canonicalEvent = historicalEvents.find(
  (entry) => entry.id === id
);

if (!canonicalEvent) {
  throw new Error(`Unknown historical event: ${id}`);
}
const event = localized('events', canonicalEvent, pageLocale);

---

<aside
  class="historical-event-reference"
  aria-label={t("Related historical event")}
>
  <p class="historical-event-reference__eyebrow">
    {t("Explore this historical event")}
  </p>

  <a
    class="historical-event-reference__link"
    href={localPath(`events/${event.id}/`, pageLocale)}
  >
    <strong>{event.title}</strong>
    <span aria-hidden="true">↗</span>
  </a>

  <p class="historical-event-reference__summary">
    {event.summary}
  </p>
</aside>

<style lang="scss">
  .historical-event-reference {
    margin-block: 2.5rem;
    padding: clamp(1.25rem, 3vw, 1.8rem);
    background: var(--paper-deep);
    border: 1px solid var(--line);
    border-left: 3px solid var(--gold);
  }

  .historical-event-reference__eyebrow {
    margin: 0 0 0.9rem;
    color: var(--link-color);
    font-size: 0.75rem;
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .historical-event-reference__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink);
    text-decoration: none;
  }

  .historical-event-reference__link strong {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.65rem);
    font-weight: normal;
    line-height: 1.3;
  }

  .historical-event-reference__link span {
    color: var(--gold);
    font-size: 1.4rem;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .historical-event-reference__link:hover strong {
    color: var(--link-color);
  }

  .historical-event-reference__link:hover span {
    transform: translate(3px, -3px);
  }

  .historical-event-reference__summary {
    margin-top: 0.8rem;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.75;
  }

  .historical-event-reference__link:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .historical-event-reference__link span {
      transition: none;
    }
  }
</style>
