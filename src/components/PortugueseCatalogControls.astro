---
interface Props { id: string; count: number }
const { id, count } = Astro.props;
---
<div class="pt-catalog-controls" data-pt-controls hidden>
  <label for={`pt-query-${id}`}>Filtrar registros neste catálogo</label>
  <div class="pt-catalog-controls__row">
    <input id={`pt-query-${id}`} data-pt-query type="search" autocomplete="off"
      placeholder="Buscar nomes e acontecimentos…" maxlength="160"
      aria-describedby={`pt-status-${id}`} />
    <button type="button" data-pt-clear disabled>Limpar busca</button>
  </div>
  <p id={`pt-status-${id}`} data-pt-status role="status" aria-live="polite"
    aria-atomic="true">{count} de {count} registros exibidos.</p>
</div>
<style>
  .pt-catalog-controls { margin: 1.5rem 0; padding: 1rem; border: 1px solid var(--line); border-radius: 0.5rem; }
  .pt-catalog-controls label { display: block; margin-bottom: 0.5rem; font-weight: 700; }
  .pt-catalog-controls__row { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; }
  .pt-catalog-controls input { min-width: 12rem; flex: 1; padding: 0.65rem; border-radius: 0.25rem; border: 1px solid currentColor; background: var(--paper-white); color: var(--ink); }
  .pt-catalog-controls button { padding: 0.65rem 1rem; border: 1px solid currentColor; border-radius: 0.25rem; background: transparent; color: inherit; cursor: pointer; }
  .pt-catalog-controls button:disabled { opacity: 0.5; cursor: default; }
  .pt-catalog-controls p { margin: 0.7rem 0 0; }
  :global([data-pt-entry][hidden]), :global([data-pt-group][hidden]) { display: none !important; }
</style>
