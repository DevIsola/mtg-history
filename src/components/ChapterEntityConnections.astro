---
import { localeForPath, localPath, phrase } from '../utils/locale';

import { getCollection, type CollectionEntry } from 'astro:content';
import { characters } from '../data/characters';
import { localized } from '../utils/localization';
import { historicalEvents } from '../data/events';
import { characterRelationships } from '../data/relationships';
import { deriveEntityContinuity, entityConnectionsForChapter } from '../data/entity-continuity.mjs';

interface Props {
  chapterId: string;
  chapters: CollectionEntry<'chapters' | 'chaptersPt'>[];
}
const { chapterId, chapters: providedChapters } = Astro.props;
const pageLocale = localeForPath(Astro.url.pathname);
const chapterTranslations = new Map((pageLocale === 'pt-BR' ? await getCollection('chaptersPt') : []).map(chapter => [chapter.id, chapter]));
const chapters = providedChapters.map(chapter => chapterTranslations.get(chapter.id) ?? chapter);
const connections = deriveEntityContinuity(chapters, characters.map(person => localized('characters', person, pageLocale)), historicalEvents, characterRelationships);
const matches = entityConnectionsForChapter(chapterId, connections);

const t = (english: string) => phrase(pageLocale, english);
---

{matches.length > 0 && (
  <aside class="entity-continuity" aria-labelledby="entity-continuity-heading" data-entity-continuity>
    <p class="eyebrow">{t("From the historical record")}</p>
    <h2 id="entity-continuity-heading">{t("People appearing across chapters")}</h2>
    <p>{t("These connections are inferred from characters named in events in both chapters. They are")} <strong>{t("evidence-index links")}</strong>{t(", not curated timelines or claims of causation.")}</p>
    <ul>
      {matches.map((connection) => {
        const otherId = connection.fromId === chapterId ? connection.toId : connection.fromId;
        const otherTitle = connection.fromId === chapterId ? connection.toTitle : connection.fromTitle;
        return (
          <li>
            <a href={localPath(`chapters/${otherId}/#chapter-reader`, pageLocale)}><strong>{otherTitle}</strong> <span aria-hidden="true">→</span></a>
            <p>{connection.people.length} {t(connection.people.length === 1 ? 'shared character referenced by documented events:' : 'shared characters referenced by documented events:')}</p>
            <ul>
              {connection.people.slice(0, 3).map((person) => (
                <li>
                  <a href={localPath(`characters/${person.id}/`, pageLocale)}>{person.name}</a>
                  {' · '}
                  <a href={localPath(`events/${connection.fromId === chapterId ? person.fromEventId : person.toEventId}/`, pageLocale)}>{t("Event here")}</a>
                  {' · '}
                  <a href={localPath(`events/${connection.fromId === chapterId ? person.toEventId : person.fromEventId}/`, pageLocale)}>{t("Event there")}</a>
                </li>
              ))}
            </ul>
            {connection.ties.length > 0 && <p>{t("Some of these figures also have separately documented relationships in the archive.")}</p>}
          </li>
        );
      })}
    </ul>
    <a class="text-link" href={localPath('paths/#entity-evidence', pageLocale)}>{t("Explore the full cross-chapter evidence index →")}</a>
  </aside>
)}

<style lang="scss">
  .entity-continuity { border-top: 1px solid var(--line); margin-block: 1.7rem 2.4rem; padding-top: 1.8rem; }
  .entity-continuity h2 { font-family: var(--font-display); font-size: clamp(1.35rem, 2.4vw, 1.8rem); margin-top: 0.3rem; }
  .entity-continuity > p:not(.eyebrow) { color: var(--ink-soft); line-height: 1.65; max-width: 75ch; margin-top: 0.7rem; }
  .entity-continuity > ul { list-style: none; padding: 0; margin: 1.2rem 0; display: grid; gap: 0.85rem; }
  .entity-continuity > ul > li { border: 1px solid var(--line); background: var(--paper-white); padding: 1rem 1.2rem; }
  .entity-continuity li > a { color: var(--link-color); }
  .entity-continuity li > p { color: var(--ink-soft); font-size: 0.9rem; line-height: 1.6; margin-top: 0.55rem; }
  .entity-continuity li ul { list-style: disc; padding-left: 1.3rem; margin-top: 0.55rem; }
  .entity-continuity li ul li { padding-block: 0.2rem; line-height: 1.6; }
  .entity-continuity li ul a { color: var(--link-color); text-decoration: underline; text-underline-offset: 0.16em; }
  .entity-continuity a:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
</style>
