---
import { withBase } from '../utils/paths';
import ThemeToggle from './ThemeToggle.astro';
import { isTranslatedRoute, translatedSuffix, uiFor } from '../utils/i18n.mjs';

interface Props { locale?: 'en' | 'pt-BR'; }
const { locale = 'en' } = Astro.props;
const ui = uiFor(locale);
const pt = locale === 'pt-BR';
const paired = isTranslatedRoute(Astro.url.pathname, withBase(''));
const suffix = translatedSuffix(Astro.url.pathname, withBase(''));
const home = withBase(pt ? 'pt-br/' : '');
const timeline = withBase(pt ? 'pt-br/timeline/' : 'timeline/');
const search = withBase(pt ? 'pt-br/search/' : 'search/');
const about = withBase('about/');
const englishChoice = withBase(paired ? suffix ?? '' : '');
const portugueseChoice = withBase(paired ? 'pt-br/' + (suffix ?? '') : 'pt-br/');
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const selected = (href: string) => current === (href.replace(/\/+$/, '') || '/');
const destinations = [
  {label: pt ? 'Explorar' : 'Explore home', href: withBase(pt ? 'pt-br/explore/' : 'explore/')},
  {label: pt ? 'Índice enciclopédico (EN)' : 'Encyclopedia directory', href: withBase('discover/')},
  {label: pt ? 'Cronologia' : 'Timeline', href: timeline},
  {label: pt ? 'Personagens' : 'Characters', href: withBase(pt ? 'pt-br/characters/' : 'characters/')},
  {label: pt ? 'Eventos' : 'Events', href: withBase(pt ? 'pt-br/events/' : 'events/')},
  {label: pt ? 'Relações (EN)' : 'Relationships', href: withBase('relationships/')},
  {label: pt ? 'Arquivo ilustrado' : 'Illustrated archive', href: withBase(pt ? 'pt-br/archive/' : 'archive/')},
  {label: pt ? 'Glossário (EN)' : 'Glossary', href: withBase('glossary/')},
  {label: pt ? 'Caminhos históricos (EN)' : 'History paths', href: withBase('paths/')},
];
const readLabel = pt ? 'Ler' : 'Read';
const exploreLabel = pt ? 'Explorar' : 'Explore';
const aboutLabel = pt ? 'Sobre (EN)' : 'About';
const searchLabel = pt ? 'Buscar no arquivo' : 'Search the archive';
---
<header class="site-header">
  <div class="site-header__inner page-shell">
    <a class="brand" href={home} aria-label={ui.homeAria}>
      <span class="brand__sigil" aria-hidden="true">✦</span>
      <span class="brand__name">Chronicles <span>of the Multiverse</span></span>
    </a>
    <div class="site-header__actions">
      <nav class="desktop-navigation" aria-label={ui.navAria}>
        <a href={timeline} aria-current={selected(timeline) ? 'page' : undefined}>{readLabel}</a>
        <details class="site-explore-menu" data-site-explore-menu>
          <summary>{exploreLabel} <span aria-hidden="true">⌄</span></summary>
          <div class="site-explore-menu__panel">
            {destinations.map(item => (
              <a href={item.href} aria-current={selected(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
          </div>
        </details>
        <a href={about} aria-current={selected(about) ? 'page' : undefined}>{aboutLabel}</a>
      </nav>
      <a class="site-header__search" href={search} aria-label={searchLabel}>
        <span aria-hidden="true" class="site-header__search-icon">⌕</span>
        <span class="site-header__search-text">{searchLabel}</span>
      </a>
      <ThemeToggle />
      <details class="site-header__languages">
        <summary aria-label={pt ? 'Escolher idioma' : 'Choose language'}>
          {pt ? 'PT' : 'EN'} <span aria-hidden="true">⌄</span>
        </summary>
        <div class="site-header__language-menu">
          <a href={englishChoice} hreflang={paired ? 'en' : undefined} aria-current={!pt ? 'page' : undefined}>
            English{!paired ? ' — home' : ''}
          </a>
          <a href={portugueseChoice} hreflang={paired ? 'pt-BR' : undefined} aria-current={pt ? 'page' : undefined}>
            Português{!paired ? ' — início' : ''}
          </a>
        </div>
      </details>
      <details class="mobile-navigation">
        <summary aria-label={ui.toggle}><span>{ui.menu}</span><span aria-hidden="true">☰</span></summary>
        <nav aria-label={ui.mobileAria}>
          <a href={timeline} aria-current={selected(timeline) ? 'page' : undefined}>{readLabel}</a>
          {destinations.map(item => (
            <a href={item.href} aria-current={selected(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href={about} aria-current={selected(about) ? 'page' : undefined}>{aboutLabel}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
