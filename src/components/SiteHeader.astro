---
import { withBase } from '../utils/paths';

const links = [
  { label: 'Home', href: withBase('') },
  { label: 'Timeline', href: withBase('timeline/') },
  { label: 'About', href: withBase('about/') },
];
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="site-header">
  <div class="site-header__inner page-shell">
    <a class="brand" href={withBase('')} aria-label="Chronicles of the Multiverse, home">
      <span class="brand__sigil" aria-hidden="true">✦</span>
      <span class="brand__name">Chronicles <span>of the Multiverse</span></span>
    </a>

    <nav class="desktop-navigation" aria-label="Main navigation">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={current === (link.href.replace(/\/+$/, '') || '/') ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <details class="mobile-navigation">
      <summary aria-label="Toggle navigation"><span>Menu</span><span aria-hidden="true">☰</span></summary>
      <nav aria-label="Mobile navigation">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>
