---
import { withBase } from '../utils/paths';
import { localeForPath, localPath, phrase } from '../utils/locale';
import ThemeToggle from './ThemeToggle.astro';
import SearchPalette from './SearchPalette.astro';

interface Props { locale?: 'en' | 'pt-BR'; }
const { locale = localeForPath(Astro.url.pathname) } = Astro.props;
const pageLocale = locale;
const t = (english: string) => phrase(pageLocale, english);
const pt = locale === 'pt-BR';
const suffix = Astro.url.pathname.slice(withBase('').length).replace(/^pt-br(?:\/|$)/, '');
const home = localPath('', locale);
const timeline = localPath('timeline/', locale);
const search = localPath('search/', locale);
const about = localPath('about/', locale);
const englishChoice = withBase(suffix);
const portugueseChoice = localPath(suffix, 'pt-BR');
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const selected = (href: string) => current === (href.replace(/\/+$/, '') || '/');
const destinations = [
  { label: t('Explore home'), href: localPath('explore/', locale) },
  { label: t('Encyclopedia directory'), href: localPath('discover/', locale) },
  { label: t('Timeline'), href: timeline },
  { label: t('Characters'), href: localPath('characters/', locale) },
  { label: t('Events'), href: localPath('events/', locale) },
  { label: t('Relationships'), href: localPath('relationships/', locale) },
  { label: t('Illustrated archive'), href: localPath('archive/', locale) },
  { label: t('Glossary'), href: localPath('glossary/', locale) },
  { label: t('History paths'), href: localPath('paths/', locale) },
];
const readLabel = t('Read');
const exploreLabel = t('Explore');
const aboutLabel = t('About');
const searchLabel = t('Search worlds, people, events…');
---
<header class="site-header">
  <div class="site-header__inner page-shell">
    <a class="brand" href={home} aria-label={t('Chronicles of the Multiverse, home')}>
      <span class="brand__sigil" aria-hidden="true">✦</span>
      <span class="brand__name">{t("Chronicles")} <span>{t("of the Multiverse")}</span></span>
    </a>
    <div class="site-header__actions">
      <nav class="desktop-navigation" aria-label={t('Main navigation')}>
        <a href={timeline} aria-current={selected(timeline) || current.includes('/chapters/') ? 'page' : undefined}>{readLabel}</a>
        <details class="site-explore-menu" data-site-explore-menu>
          <summary>{exploreLabel} <span aria-hidden="true">⌄</span></summary>
          <div class="site-explore-menu__panel">
            {destinations.map(item => (
              <a href={item.href} aria-current={selected(item.href) ? 'page' : undefined}>{item.label}</a>
            ))}
          </div>
        </details>
        <a href={about} aria-current={selected(about) ? 'page' : undefined}>{aboutLabel}</a>
      </nav>
      <a class="site-header__search" href={search} aria-label={searchLabel + ' ⌘ K'} data-search-palette-trigger aria-keyshortcuts="Meta+K Control+K">
        <span aria-hidden="true" class="site-header__search-icon">⌕</span>
        <span class="site-header__search-text">{searchLabel}</span>
        <kbd class="site-header__shortcut" aria-hidden="true">⌘ K</kbd>
      </a>
      <a class="site-header__support" href="https://ko-fi.com/B1H328PBAR" target="_blank" rel="noopener noreferrer" aria-label={t('Support DevIsola on Ko-fi')}>
        <span aria-hidden="true">♥</span>
        <span class="site-header__support-text">{t('Support')}</span>
      </a>
      <ThemeToggle />
      <details class="site-header__languages">
        <summary aria-label={pt ? 'PT — Escolher idioma' : 'EN — Choose language'}>
          {pt ? 'PT' : 'EN'} <span aria-hidden="true">⌄</span>
        </summary>
        <div class="site-header__language-menu">
          <a href={englishChoice} hreflang="en" aria-current={!pt ? 'page' : undefined}>
            English
          </a>
          <a href={portugueseChoice} hreflang="pt-BR" aria-current={pt ? 'page' : undefined}>
            Português
          </a>
        </div>
      </details>
      <details class="mobile-navigation">
        <summary aria-label={t('Toggle navigation')}><span>{t('Menu')}</span><span aria-hidden="true">☰</span></summary>
        <nav aria-label={t('Mobile navigation')}>
          <a href={timeline} aria-current={selected(timeline) ? 'page' : undefined}>{readLabel}</a>
          {destinations.map(item => (
            <a href={item.href} aria-current={selected(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href={about} aria-current={selected(about) ? 'page' : undefined}>{aboutLabel}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<SearchPalette locale={locale} />
