
---
import { withBase } from '../utils/paths';
import ThemeToggle from './ThemeToggle.astro';
import { isTranslatedRoute, translatedSuffix, uiFor } from '../utils/i18n.mjs';

interface Props { locale?: 'en' | 'pt-BR'; }
const { locale = 'en' } = Astro.props;
const ui = uiFor(locale);
const suffix = translatedSuffix(Astro.url.pathname, withBase(''));
const showLanguageSwitch = isTranslatedRoute(Astro.url.pathname, withBase(''));

// Keep the established English routes and their regression-test contract intact.
const englishLinks = [
  { label: 'Home', href: withBase('') },
  { label: 'Discover', href: withBase('discover/') },
  { label: 'Search', href: withBase('search/') },
  { label: 'Timeline', href: withBase('timeline/') },
  { label: 'Characters', href: withBase('characters/') },
  { label: 'Archive', href: withBase('archive/') },
  { label: 'About', href: withBase('about/') },
];
const ptPaths = ['pt-br/', 'discover/', 'search/', 'pt-br/timeline/', 'pt-br/characters/', 'pt-br/archive/', 'about/'];
const links = locale === 'pt-BR'
  ? ui.navigation.map((label, index) => ({ label, href: withBase(ptPaths[index]) }))
  : englishLinks;
const switchPath = locale === 'pt-BR' ? (suffix ?? '') : `pt-br/${suffix ?? ''}`;
const switchLabel = locale === 'pt-BR' ? 'EN' : 'PT-BR';
const switchAria = locale === 'pt-BR' ? 'Switch to English' : 'Mudar para português brasileiro';



const current =
  Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="site-header">
  <div class="site-header__inner page-shell">
    <a
      class="brand"
      href={withBase(locale === 'pt-BR' ? 'pt-br/' : '')}
      aria-label={ui.homeAria}
    >
      <span class="brand__sigil" aria-hidden="true">✦</span>

      <span class="brand__name">
        Chronicles <span>of the Multiverse</span>
      </span>
    </a>

    <div class="site-header__actions">
      <nav
        class="desktop-navigation"
        aria-label={ui.navAria}
      >
        {links.map((link) => (
          <a
            href={link.href}
            aria-current={
              current === (
                link.href.replace(/\/+$/, '') || '/'
              )
                ? 'page'
                : undefined
            }
          >
            {link.label}
          </a>
        ))}
      </nav>

      <ThemeToggle />

      {showLanguageSwitch && (
        <a class="site-header__language" href={withBase(switchPath)}
          hreflang={locale === 'pt-BR' ? 'en' : 'pt-BR'}
          aria-label={switchAria}>{switchLabel}</a>
      )}

      <details class="mobile-navigation">
        <summary aria-label={ui.toggle}>
          <span>{ui.menu}</span>
          <span aria-hidden="true">☰</span>
        </summary>

        <nav aria-label={ui.mobileAria}>
          {links.map((link) => (
            <a
              href={link.href}
              aria-current={
                current === (
                  link.href.replace(/\/+$/, '') || '/'
                )
                  ? 'page'
                  : undefined
              }
            >
              {link.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header__language {
    flex: 0 0 auto;
    color: var(--gold-light);
    border: 1px solid currentColor;
    border-radius: 0.3rem;
    padding: 0.25rem 0.4rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-decoration: none;
  }
  .site-header__language:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
</style>
