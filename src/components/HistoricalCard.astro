
---
import { getEntry } from 'astro:content';
import { cardImageUrl, cardImageSrcset, cardScryfallUrl } from '../utils/card-printings';

type HistoricalCardData = { scryfallId: string; significance: string };

interface Props {
  card: HistoricalCardData;
  compact?: boolean;
}

const { card: legacyCard, compact = false } = Astro.props;
const printing = await getEntry('cards', legacyCard.scryfallId);
if (!printing) throw new Error(`Missing canonical card ${legacyCard.scryfallId}`);
// Printing fields come only from the canonical collection. Significance is local.
const card = { ...printing.data, scryfallId: printing.id, significance: legacyCard.significance };
const imageUrl = cardImageUrl(printing.id);
const imageSrcset = cardImageSrcset(printing.id);
const cardUrl = cardScryfallUrl(card);
---

<figure class={compact ? 'historical-card historical-card--plate' : 'historical-card'}>
  <a
    href={cardUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`View ${card.name} on Scryfall`}
  >
    <img
      src={imageUrl}
      srcset={imageSrcset}
      sizes="(max-width: 600px) 85vw, 488px"
      alt={`${card.name}, illustrated by ${card.artist}`}
      width="488"
      height="680"
      loading="lazy"
      decoding="async"
    />
  </a>

  <figcaption class="historical-card__caption">
    <h3>{card.name}</h3>

    {compact ? (
      <details class="historical-card__interpretation">
        <summary>Art and historical context</summary>
        <p class="historical-card__significance">{card.significance}</p>
      </details>
    ) : (
      <p class="historical-card__significance">{card.significance}</p>
    )}

    <p class="historical-card__credit">
      Illustrated by {card.artist}
      · {card.setCode.toUpperCase()}
      #{card.collectorNumber}
    </p>

    <a
      class="historical-card__source"
      href={cardUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      View card on Scryfall ↗
    </a>
    <button
      class="historical-card__enlarge"
      type="button"
      hidden
      data-card-artwork-open
      data-printing-id={printing.id}
      data-card-name={card.name}
      data-card-artist={card.artist}
      data-card-set={card.setCode}
      data-card-number={card.collectorNumber}
      data-card-significance={card.significance}
      aria-haspopup="dialog"
      aria-controls="card-artwork-viewer"
    >
      Enlarge card image
    </button>
  </figcaption>
</figure>

<style lang="scss">
  @use "../styles/breakpoints" as bp;

  .historical-card {
    margin: 0;
    min-width: 0;
  }

  .historical-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4.7% / 3.4%;
  }

  .historical-card__caption {
    padding-top: 1.25rem;
  }

  .historical-card__caption h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: normal;
    line-height: 1.3;
  }

  .historical-card__significance {
    margin-top: 0.75rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .historical-card__interpretation {
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }

  .historical-card__interpretation summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: var(--link-color);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }

  .historical-card__interpretation summary:focus-visible {
    outline: 3px solid var(--link-color);
    outline-offset: 2px;
  }

  .historical-card__interpretation .historical-card__significance {
    margin-top: 0.25rem;
  }

  .historical-card__credit {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--jade);
  }

  .historical-card__source {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--link-color);
    font-size: 0.8rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .historical-card__enlarge {
    display: block;
    margin-top: 0.75rem;
    padding: 0.55rem 0.85rem;
    min-height: 44px;
    border: 1px solid var(--line);
    background: var(--paper-deep);
    color: var(--link-color);
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
  }
  .historical-card__enlarge[hidden] { display: none; }
  .historical-card__enlarge:focus-visible { outline: 3px solid var(--link-color); outline-offset: 3px; }

  @media (max-width: bp.$small) {
    .historical-card {
      max-width: 340px;
      margin-inline: auto;
    }
  }
</style>
