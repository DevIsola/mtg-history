
---
import { getEntry } from 'astro:content';
import { archiveCard, cardLabels } from '../utils/card-localization';
import { localeForPath } from '../utils/locale';

type HistoricalCardData = { scryfallId: string; significance: string };

interface Props {
  card: HistoricalCardData;
  compact?: boolean;
}

const { card: legacyCard, compact = false } = Astro.props;
const printing = await getEntry('cards', legacyCard.scryfallId);
if (!printing) throw new Error(`Missing canonical card ${legacyCard.scryfallId}`);
// Printing fields come only from the canonical collection. Significance is local.
const card = { ...printing.data, scryfallId: printing.id, significance: legacyCard.significance };
const locale = localeForPath(Astro.url.pathname);
const pt = locale === 'pt-BR';
const labels = cardLabels(locale);
const displayed = archiveCard(card, locale);
const imageUrl = displayed.imageUrl;
const imageSrcset = displayed.imageSrcset;
const cardUrl = displayed.scryfallUrl;
---

<figure class={compact ? 'historical-card historical-card--plate' : 'historical-card'}
  data-canonical-id={printing.id} data-displayed-id={displayed.printingId} data-language={displayed.language}>
  <a
    href={cardUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={pt ? `Ver ${displayed.name} no Scryfall` : `View ${card.name} on Scryfall`}
  >
    <img
      src={imageUrl}
      srcset={imageSrcset}
      sizes="(max-width: 600px) 85vw, 488px"
      alt={`${displayed.name}, ${pt ? 'ilustração de' : 'illustrated by'} ${displayed.artist}`}
      width="488"
      height="680"
      loading="lazy"
      decoding="async"
    />
  </a>

  <figcaption class="historical-card__caption">
    <h3>{displayed.name}</h3>
    {pt && <p class="historical-card__language">{displayed.translated ? labels.language : labels.fallback}</p>}

    {compact ? (
      <details class="historical-card__interpretation">
        <summary>{labels.artContext}</summary>
        <p class="historical-card__significance">{card.significance}</p>
      </details>
    ) : (
      <p class="historical-card__significance">{card.significance}</p>
    )}

    <p class="historical-card__credit">
      {labels.illustratedBy} {displayed.artist}
      · {card.setCode.toUpperCase()}
      #{card.collectorNumber}
    </p>

    <a
      class="historical-card__source"
      href={cardUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {labels.viewCard}
    </a>
    {pt && displayed.translated && <a class="historical-card__source" href={displayed.originalUrl} target="_blank" rel="noopener noreferrer">{labels.original}</a>}
    <button
      class="historical-card__enlarge"
      type="button"
      hidden
      data-card-artwork-open
      data-canonical-id={printing.id}
      data-printing-id={displayed.printingId}
      data-card-source={cardUrl}
      data-card-original-source={displayed.originalUrl}
      data-card-language={displayed.language}
      data-card-name={displayed.name}
      data-card-artist={displayed.artist}
      data-card-set={card.setCode}
      data-card-number={card.collectorNumber}
      data-card-significance={card.significance}
      aria-haspopup="dialog"
      aria-controls="card-artwork-viewer"
    >
      {labels.enlarge}
    </button>
  </figcaption>
</figure>

<style lang="scss">
  @use "../styles/breakpoints" as bp;

  .historical-card {
    margin: 0;
    min-width: 0;
  }

  .historical-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4.7% / 3.4%;
  }

  .historical-card__caption {
    padding-top: 1.25rem;
  }

  .historical-card__caption h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: normal;
    line-height: 1.3;
  }

  .historical-card__significance {
    margin-top: 0.75rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .historical-card__interpretation {
    margin-top: 0.75rem;
  }

  /* Native details/summary remains usable without JS, including keyboard input. */
  .historical-card__interpretation summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--paper-deep);
    color: var(--link-color);
    font-size: 0.78rem;
    font-weight: 700;
    list-style: none;
    cursor: pointer;
  }

  .historical-card__interpretation summary::-webkit-details-marker { display: none; }

  /* Two bars when closed (+), one when expanded (-). Decorative only. */
  .historical-card__interpretation summary::after {
    content: '';
    display: block;
    flex: 0 0 1.15rem;
    width: 1.15rem;
    height: 1.15rem;
    border: 1px solid currentColor;
    border-radius: 2px;
    background:
      linear-gradient(currentColor, currentColor) center / 8px 2px no-repeat,
      linear-gradient(currentColor, currentColor) center / 2px 8px no-repeat;
  }

  .historical-card__interpretation[open] summary::after {
    background: linear-gradient(currentColor, currentColor) center / 8px 2px no-repeat;
  }

  .historical-card__interpretation summary:hover,
  .historical-card__interpretation[open] summary {
    border-color: var(--link-color);
  }

  .historical-card__interpretation summary:focus-visible {
    outline: 3px solid var(--link-color);
    outline-offset: 2px;
  }

  .historical-card__interpretation .historical-card__significance {
    margin-top: 0.25rem;
  }

  .historical-card__credit,
  .historical-card__language {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--jade);
  }

  .historical-card__source {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--link-color);
    font-size: 0.8rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .historical-card__enlarge {
    display: block;
    margin-top: 0.75rem;
    padding: 0.55rem 0.85rem;
    min-height: 44px;
    border: 1px solid var(--line);
    background: var(--paper-deep);
    color: var(--link-color);
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
  }
  .historical-card__enlarge[hidden] { display: none; }
  .historical-card__enlarge:focus-visible { outline: 3px solid var(--link-color); outline-offset: 3px; }

  @media (max-width: bp.$small) {
    .historical-card {
      max-width: 340px;
      margin-inline: auto;
    }
  }
</style>
