
---
import { getEntry } from 'astro:content';

type HistoricalCardData = { scryfallId: string; significance: string };

interface Props {
  card: HistoricalCardData;
}

const { card: legacyCard } = Astro.props;
const printing = await getEntry('cards', legacyCard.scryfallId);
if (!printing) throw new Error(`Missing canonical card ${legacyCard.scryfallId}`);
// Printing fields come only from the canonical collection. Significance is local.
const card = { ...printing.data, scryfallId: printing.id, significance: legacyCard.significance };
const id = printing.id;
const imageUrl =
  `https://cards.scryfall.io/normal/front/${id[0]}/${id[1]}/${id}.jpg`;
const cardUrl =
  `https://scryfall.com/card/${card.setCode}/${card.collectorNumber}`;
---

<figure class="historical-card">
  <a
    href={cardUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`View ${card.name} on Scryfall`}
  >
    <img
      src={imageUrl}
      alt={`${card.name}, illustrated by ${card.artist}`}
      width="488"
      height="680"
      loading="lazy"
      decoding="async"
    />
  </a>

  <figcaption class="historical-card__caption">
    <h3>{card.name}</h3>

    <p class="historical-card__significance">
      {card.significance}
    </p>

    <p class="historical-card__credit">
      Illustrated by {card.artist}
      · {card.setCode.toUpperCase()}
      #{card.collectorNumber}
    </p>

    <a
      class="historical-card__source"
      href={cardUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      View card on Scryfall ↗
    </a>
  </figcaption>
</figure>

<style lang="scss">
  @use "../styles/breakpoints" as bp;

  .historical-card {
    margin: 0;
    min-width: 0;
  }

  .historical-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4.7% / 3.4%;
  }

  .historical-card__caption {
    padding-top: 1.25rem;
  }

  .historical-card__caption h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: normal;
    line-height: 1.3;
  }

  .historical-card__significance {
    margin-top: 0.75rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .historical-card__credit {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--jade);
  }

  .historical-card__source {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--link-color);
    font-size: 0.8rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: bp.$small) {
    .historical-card {
      max-width: 340px;
      margin-inline: auto;
    }
  }
</style>
