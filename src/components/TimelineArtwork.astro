---
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { chapterCardUse } from '../utils/card-printings';
import { archiveCard, cardLabels, artworkAttributes } from '../utils/card-localization';
import { localeForPath } from '../utils/locale';

interface Props { chapter: CollectionEntry<'chapters'> | CollectionEntry<'chaptersPt'>; }
const { chapter } = Astro.props;
const locale = localeForPath(Astro.url.pathname);
const pt = locale === 'pt-BR';
const labels = cardLabels(locale);
const canonicalChapter = chapter.collection === 'chapters' ? chapter : await getEntry('chapters', chapter.id);
if (!canonicalChapter) throw new Error(`Timeline: missing canonical chapter ${chapter.id}`);
const editorialChapter = pt && chapter.collection !== 'chaptersPt' ? await getEntry('chaptersPt', chapter.id) : chapter;
if (!editorialChapter) throw new Error(`Timeline: missing localized chapter ${chapter.id}`);
const printings = new Map((await getCollection('cards')).map(({ id, data }) => [id, data]));
const canonical = chapterCardUse(canonicalChapter, 0, printings);
const card = archiveCard(canonical, locale);
const significance = editorialChapter.data.cards[0].significance;
---
<figure class="atlas-era__artwork" data-timeline-artwork data-printing-id={card.printingId} data-canonical-id={card.canonicalId} data-language={card.language}>
  <a {...artworkAttributes(card, significance, locale)} target="_blank" rel="noopener noreferrer">
    <img src={card.imageUrl} srcset={card.imageSrcset}
      sizes="(max-width: 900px) 180px, 230px" width="488" height="680"
      loading="lazy" decoding="async"
      alt={pt ? `${card.name}, uma ilustração de carta selecionada de ${card.artist}` : `${card.name}, a curated card illustration by ${card.artist}`} />
  </a>
  <figcaption>
    <span class="atlas-era__artwork-label">{pt ? 'Ilustração selecionada · não é uma fotografia literal do acontecimento' : 'Curated illustration · not a literal event photograph'}</span>
    {pt && <span class="atlas-era__artwork-label">{card.translated ? labels.language : labels.fallback}</span>}
    <strong>{card.name}</strong>
    <span class="atlas-era__artwork-credit">{card.artist} · {card.setCode.toUpperCase()} #{card.collectorNumber}</span>
    <details class="atlas-era__artwork-context">
      <summary>{pt ? 'Por que esta ilustração aparece' : 'Why this illustration appears'}</summary>
      <p>{significance}</p>
      {pt && <a href={card.originalUrl} target="_blank" rel="noopener noreferrer">{labels.original}</a>}
    </details>
  </figcaption>
</figure>
