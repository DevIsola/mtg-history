---
const pageLocale = localeForPath(Astro.url.pathname);
const pt = pageLocale === 'pt-BR';
const withBase = (path = '') => localPath(path, pageLocale);

import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import HistoricalCard from '../../components/HistoricalCard.astro';
import EventEvidence from '../../components/EventEvidence.astro';
import UnverifiedEventNotice from '../../components/UnverifiedEventNotice.astro';

import {
  historicalEvents as canonical_historicalEvents,
  type HistoricalEvent,
} from '../../data/events';

import { characters as canonical_characters } from '../../data/characters';
import { localPath, localeForPath, phrase } from '../../utils/locale';
import { localized } from '../../utils/localization';
import { chapterCardUse } from '../../utils/card-printings';
import { eventProvenance } from '../../data/event-provenance.mjs';
import manualEventReviews from '../../data/manual-event-review.json';
const historicalEvents = canonical_historicalEvents.map(record => localized('events', record, pageLocale));

const characters = canonical_characters.map(record => localized('characters', record, pageLocale));


type Chapter = CollectionEntry<'chapters' | 'chaptersPt'>;
type Card = ReturnType<typeof chapterCardUse>;

const { event: originalEvent, chapter: originalChapter, card: originalCard } = Astro.props as {
  event: HistoricalEvent;
  chapter: Chapter;
  card: Card;
};
const event = localized('events', originalEvent, pageLocale);
const chapter = pt ? (await getCollection('chaptersPt')).find(entry => entry.id === originalChapter.id)! : originalChapter;
const cardIndex = chapter.data.cardIds.findIndex(reference => reference.id === event.cardId);
const card = { ...originalCard, significance: chapter.data.cards[cardIndex].significance };


const people = event.characterIds.map((id) => {
  const character = characters.find(
    (entry) => entry.id === id
  );

  if (!character) {
    throw new Error(`Unknown historical character: ${id}`);
  }

  return character;
});

const sourceProvenance = eventProvenance[event.id];
const provenance = sourceProvenance ? localized('provenance', { id: event.id, ...sourceProvenance }, pageLocale) : undefined;
const manualReview = Object.values(manualEventReviews).find(
  (item) => item.eventId === event.id
);
if (manualReview && provenance) {
  throw new Error(`Event ${event.id}: manual review conflicts with reviewed provenance`);
}

const currentIndex = historicalEvents.findIndex(
  (entry) => entry.id === event.id
);

const previousEvent =
  currentIndex > 0
    ? historicalEvents[currentIndex - 1]
    : undefined;

const nextEvent =
  currentIndex >= 0 &&
  currentIndex < historicalEvents.length - 1
    ? historicalEvents[currentIndex + 1]
    : undefined;
---

<BaseLayout locale={pageLocale}
  title={event.title}
  description={event.summary}
  printingId={event.cardId}
>
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">
        {phrase(pageLocale, "Historical event")}
        {' · '}
        {chapter.data.chronology.storyPeriod}
      </p>

      <h1>{event.title}</h1>
      <p>{event.summary}</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="page-shell">

      <a
        class="text-link"
        href={withBase('events/')}
      >
        {phrase(pageLocale, "← All historical events")}
      </a>

      <div class="historical-event-detail">
        <div class="historical-event-detail__main">

          <p class="eyebrow">
            {phrase(pageLocale, "The historical record")}
          </p>

          <h2>
            {event.title}
          </h2>

          <div class="historical-event-detail__narrative">
            {event.narrative.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          {provenance && <EventEvidence entry={provenance} />}
          {manualReview && <UnverifiedEventNotice entry={manualReview} />}

          <section class="historical-event-detail__related">
            <p class="eyebrow">
              {phrase(pageLocale, "Connected chapter")}
            </p>

            <a
              class="historical-event-detail__chapter"
              href={withBase(`chapters/${chapter.id}/`)}
            >
              <span>
                {phrase(pageLocale, "Chapter")} {String(chapter.data.order).padStart(2, '0')}
              </span>

              <strong>{chapter.data.title}</strong>

              <span aria-hidden="true">→</span>
            </a>
          </section>

          {people.length > 0 && (
          <section class="historical-event-detail__related">
            <p class="eyebrow">
              {phrase(pageLocale, "Figures involved")}
            </p>

            <h3>{phrase(pageLocale, "Connected characters")}</h3>

            <ul class="historical-event-detail__people">
              {people.map((person) => (
                <li>
                  <a
                    href={withBase(`characters/${person.id}/`)}
                  >
                    <strong>{person.name}</strong>
                    <span>{person.title}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
          )}

        </div>

        <aside class="historical-event-detail__aside">
          <p class="eyebrow">
            {phrase(pageLocale, "From the illustrated archive")}
          </p>

          <HistoricalCard card={card} />

          <a
            class="text-link"
            href={withBase(`archive/#${chapter.id}`)}
          >
            {phrase(pageLocale, "Browse this chapter's cards →")}
          </a>
        </aside>
      </div>

      <nav
        class="historical-event-pagination"
        aria-label={phrase(pageLocale, "Previous and next historical events")}
      >
        {previousEvent && (
          <a
            class="historical-event-pagination__previous"
            href={withBase(`events/${previousEvent.id}/`)}
          >
            <span>{phrase(pageLocale, "← Previous event")}</span>
            <strong>{previousEvent.title}</strong>
          </a>
        )}

        {nextEvent && (
          <a
            class="historical-event-pagination__next"
            href={withBase(`events/${nextEvent.id}/`)}
          >
            <span>{phrase(pageLocale, "Next event →")}</span>
            <strong>{nextEvent.title}</strong>
          </a>
        )}
      </nav>

    </div>
  </section>
</BaseLayout>
