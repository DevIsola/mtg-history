---
const pageLocale = localeForPath(Astro.url.pathname);
const pt = pageLocale === 'pt-BR';
const withBase = (path = '') => localPath(path, pageLocale);

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { historicalEvents as canonical_historicalEvents } from '../../data/events';
import { localPath, localeForPath, phrase } from '../../utils/locale';
import { localized } from '../../utils/localization';
import { resolvePrinting } from '../../utils/card-printings';
import { archiveCard, cardLabels } from '../../utils/card-localization';
const printingLabels = cardLabels(pageLocale);
const historicalEvents = canonical_historicalEvents.map(record => localized('events', record, pageLocale));


const chapters = (await getCollection(pt ? 'chaptersPt' : 'chapters')).sort(
  (a, b) => a.data.order - b.data.order
);

const cardCatalog = new Map((await getCollection('cards')).map(({ id, data }) => [id, data]));

const sections = chapters
  .map((chapter) => {
    const events = historicalEvents
      .filter((event) => event.chapterId === chapter.id)
      .map((event) => {
        if (!chapter.data.cardIds.some((reference) => reference.id === event.cardId)) {
          throw new Error(`Event ${event.id}: printing ${event.cardId} not curated in chapter ${chapter.id}`);
        }
        const card = archiveCard(resolvePrinting(cardCatalog, event.cardId, `event ${event.id}`), pageLocale);
        return { event, cardName: card.name, imageUrl: card.imageUrl, imageSrcset: card.imageSrcset, imageLanguageLabel: card.translated ? printingLabels.language : printingLabels.fallback };
      });

    return { chapter, events };
  })
  .filter((section) => section.events.length > 0);
---

<BaseLayout locale={pageLocale}
  title={phrase(pageLocale, "Historical events")}
  description={phrase(pageLocale, "Explore the defining events of Magic: The Gathering's history, connected to chapters, characters, and illustrated cards.")}
>
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">
        {phrase(pageLocale, "The historical encyclopedia")}
      </p>

      <h1>{phrase(pageLocale, "Events that shaped")} <em>{phrase(pageLocale, "the Multiverse.")}</em></h1>

      <p>
        {phrase(pageLocale, "Wars, discoveries, sacrifices, and transformations. Explore the pivotal moments behind Magic's stories.")}
      </p>
    </div>
  </section>

  <section class="section-spacing historical-events">
    <div class="page-shell">

      <div class="historical-events__intro">
        <p class="eyebrow">{phrase(pageLocale, "An evolving record")}</p>

        <h2 class="section-title">
          {phrase(pageLocale, "The turning points of")} <em>{phrase(pageLocale, "history.")}</em>
        </h2>

        <p>
          {historicalEvents.length} {phrase(pageLocale, "curated historical events across")} {sections.length} {phrase(pageLocale, "published chapters. Each record connects to its narrative, central figures, and representative card artwork.")}
        </p>
      </div>

      <nav
        class="historical-events__jumps"
        aria-label={phrase(pageLocale, "Jump to historical period")}
      >
        {sections.map(({ chapter }) => (
          <a href={`#${chapter.id}`}>
            {String(chapter.data.order).padStart(2, '0')}
            {' · '}
            {chapter.data.title}
          </a>
        ))}
      </nav>

      {sections.map(({ chapter, events }) => (
        <section
          id={chapter.id}
          class="historical-events__era"
          aria-labelledby={`events-${chapter.id}`}
        >
          <div class="historical-events__era-header">
            <div>
              <p class="eyebrow">
                {phrase(pageLocale, "Chapter")} {String(chapter.data.order).padStart(2, '0')}
                {' · '}
                {chapter.data.chronology.storyPeriod}
              </p>

              <h2 id={`events-${chapter.id}`}>
                {chapter.data.title}
              </h2>
            </div>

            <a
              class="text-link"
              href={withBase(`chapters/${chapter.id}/`)}
            >
              {phrase(pageLocale, "Read chapter →")}
            </a>
          </div>

          <div class="historical-events__grid">
            {events.map(({ event, imageUrl, imageSrcset, cardName, imageLanguageLabel }) => (
              <article class="historical-event-card">
                <a
                  class="historical-event-card__image"
                  href={withBase(`events/${event.id}/`)}
                  aria-label={`${phrase(pageLocale, 'Read about')} ${event.title}`}
                >
                  <img
                    src={imageUrl}
                    srcset={imageSrcset}
                    sizes="(max-width: 600px) 85vw, (max-width: 900px) 45vw, 320px"
                    alt={`${cardName}${phrase(pageLocale, ', a card illustrating this historical period')}`}
                    width="488"
                    height="680"
                    loading="lazy"
                    decoding="async"
                  />
                </a>

                <div class="historical-event-card__content">
                  {pt && <p class="eyebrow">{imageLanguageLabel}</p>}
                  <p class="eyebrow">
                    {phrase(pageLocale, "Historical event")}
                  </p>

                  <h3>
                    <a href={withBase(`events/${event.id}/`)}>
                      {event.title}
                    </a>
                  </h3>

                  <p>{event.summary}</p>

                  <a
                    class="historical-event-card__action"
                    href={withBase(`events/${event.id}/`)}
                  >
                    {phrase(pageLocale, "Explore this event →")}
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}

    </div>
  </section>
</BaseLayout>
