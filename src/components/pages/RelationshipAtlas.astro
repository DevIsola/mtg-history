---
const pageLocale = localeForPath(Astro.url.pathname);
const pt = pageLocale === 'pt-BR';
const withBase = (path = '') => localPath(path, pageLocale);

import BaseLayout from '../../layouts/BaseLayout.astro';
import { characters as canonical_characters } from '../../data/characters';
import { characterRelationships as canonical_characterRelationships } from '../../data/relationships';
import { getCollection } from 'astro:content';
import { localPath, localeForPath, phrase } from '../../utils/locale';
import { localized } from '../../utils/localization';
import { RELATIONSHIP_COLORS } from '../../utils/relationship-colors.mjs';
const characterRelationships = canonical_characterRelationships.map(record => localized('relationships', record, pageLocale));

const characters = canonical_characters.map(record => localized('characters', record, pageLocale));


const byId = new Map(characters.map((person) => [person.id, person]));
const chapters = await getCollection(pt ? 'chaptersPt' : 'chapters');
const chapterNames = new Map(chapters.map((chapter) => [chapter.id, chapter.data.title]));
const orderedChapters = [...chapters].sort((a, b) => a.data.order - b.data.order);
const connectedIds = new Set(characterRelationships.flatMap((relation) => [relation.a, relation.b]));
const people = [...characters].filter((person) => connectedIds.has(person.id))
  .sort((a, b) => a.name.localeCompare(b.name));
const initialId = people.find((person) => person.id === 'urza')?.id ?? people[0]?.id ?? '';
const categoryLabels = {
  family: phrase(pageLocale, "Family"), friendship: phrase(pageLocale, "Friendship"), alliance: phrase(pageLocale, "Alliance"),
  rivalry: phrase(pageLocale, "Conflict"), mentorship: phrase(pageLocale, "Mentorship"), creation: phrase(pageLocale, "Creation"),
};
---
<BaseLayout locale={pageLocale}
  title={phrase(pageLocale, "Character relationship explorer")}
  description={phrase(pageLocale, "Trace the documented family ties, mentorships, alliances, and conflicts connecting historical figures in Magic's Multiverse.")}
>
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">{phrase(pageLocale, "The people behind the history")}</p>
      <h1>{phrase(pageLocale, "Connections across the")} <em>{phrase(pageLocale, "Multiverse.")}</em></h1>
      <p>{phrase(pageLocale, "Explore documented character connections in an interactive graph or follow individual relationships through the historical record.")}</p>
    </div>
  </section>

  <section class="network-section section-spacing" data-relationship-explorer>
    <div class="page-shell">
      <div class="network-intro">
        <div>
          <p class="eyebrow">{phrase(pageLocale, "Relationship atlas")}</p>
          <h2 class="section-title">{phrase(pageLocale, "History is shaped by")} <em>{phrase(pageLocale, "people.")}</em></h2>
          <p>{phrase(pageLocale, "Connections are curated from the existing historical record. Categories summarize each relationship; the descriptions and chapter links provide context.")}</p>
        </div>
        <div class="network-metrics" aria-label={phrase(pageLocale, "Relationship coverage")}>
          <div><strong>{people.length}</strong><span>{phrase(pageLocale, "connected figures")}</span></div>
          <div><strong>{characterRelationships.length}</strong><span>{phrase(pageLocale, "documented ties")}</span></div>
        </div>
      </div>

      <ol class="network-steps" aria-label={phrase(pageLocale, "How to use the relationship atlas")}>
        <li><span aria-hidden="true">01</span><strong>{phrase(pageLocale, "Choose a figure")}</strong><small>{phrase(pageLocale, "Start with a documented character")}</small></li>
        <li><span aria-hidden="true">02</span><strong>{phrase(pageLocale, "Explore the ties")}</strong><small>{phrase(pageLocale, "Filter by type or historical chapter")}</small></li>
        <li><span aria-hidden="true">03</span><strong>{phrase(pageLocale, "Read the evidence")}</strong><small>{phrase(pageLocale, "Inspect a connection or open its source chapter")}</small></li>
      </ol>

      <div class="network-tools" id="network-controls" hidden>
        <div class="network-field">
          <label for="network-person">{phrase(pageLocale, "Focus on a character")}</label>
          <select id="network-person">
            {people.map((person) => <option value={person.id} data-summary={person.summary} data-primary-chapter={person.chapterIds[0] ?? ''} selected={person.id === initialId}>{person.name}</option>)}
          </select>
        </div>
        <div class="network-field">
          <label for="network-category">{phrase(pageLocale, "Relationship type")}</label>
          <select id="network-category">
            <option value="">{phrase(pageLocale, "All relationships")}</option>
            {Object.entries(categoryLabels).map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </div>
        <button type="button" id="network-reset">{phrase(pageLocale, "Reset view")}</button>
      </div>

      <div class="network-view-switch" id="network-view-switch" hidden role="group" aria-label={phrase(pageLocale, "Relationship display mode")}>
        <span class="network-view-switch__label">{phrase(pageLocale, "View the same documented ties as")}</span>
        <button type="button" id="network-show-graph" aria-pressed="true">{phrase(pageLocale, "Visual network")}</button>
        <button type="button" id="network-show-cards" aria-pressed="false">{phrase(pageLocale, "Evidence cards")}</button>
      </div>

      <div class="network-focus" id="network-focus" hidden>
        <span class="eyebrow">{phrase(pageLocale, "Current focus")}</span>
        <strong id="network-focus-name">{byId.get(initialId)?.name ?? ''}</strong>
        <p id="network-count" role="status" aria-live="polite" aria-atomic="true"></p>
        <a id="network-profile" href={withBase('characters/' + initialId + '/')}>{phrase(pageLocale, "Open character biography →")}</a>
      </div>

      <p class="network-empty" id="network-empty" hidden>{phrase(pageLocale, "No documented connections match this category for the selected character. Choose another relationship type or a different figure.")}</p>

      <section class="network-visual" id="network-visual" aria-labelledby="network-visual-heading" hidden>
        <div class="network-visual__toolbar">
          <div>
            <h3 id="network-visual-heading">{phrase(pageLocale, "Documented connections")}</h3>
            <p>{phrase(pageLocale, "Nodes represent characters; colored lines distinguish relationship types. Drag to explore, zoom with the controls, or select a node. Use the selectors and Evidence cards for keyboard navigation and full historical context.")}</p>
          </div>
          <div class="network-visual__actions" aria-label={phrase(pageLocale, "Graph zoom controls")}>
            <button type="button" id="network-zoom-out" aria-label={phrase(pageLocale, "Zoom out of relationship graph")}>−</button>
            <button type="button" id="network-zoom-in" aria-label={phrase(pageLocale, "Zoom into relationship graph")}>+</button>
            <button type="button" id="network-fit">{phrase(pageLocale, "Fit graph")}</button>
          </div>
        </div>
        <div class="network-explore-tools" id="network-explore-tools">
          <div class="network-explore-tools__field">
            <label for="network-scope">{phrase(pageLocale, "Explore")}</label>
            <select id="network-scope">
              <option value="global">{phrase(pageLocale, "Entire network")}</option>
              <option value="local">{phrase(pageLocale, "Connections around focus")}</option>
            </select>
          </div>
          <div class="network-explore-tools__field">
            <label for="network-depth">{phrase(pageLocale, "Connection depth")}</label>
            <select id="network-depth" disabled>
              <option value="1">{phrase(pageLocale, "1 step — direct ties")}</option>
              <option value="2">{phrase(pageLocale, "2 steps")}</option>
              <option value="3">{phrase(pageLocale, "3 steps")}</option>
            </select>
          </div>
          <div class="network-explore-tools__field">
            <label for="network-era">{phrase(pageLocale, "Historical chapter")}</label>
            <select id="network-era">
              <option value="">{phrase(pageLocale, "All chapters")}</option>
              {orderedChapters.map((chapter) => (
                <option value={chapter.id}>{chapter.data.title}</option>
              ))}
            </select>
          </div>
          <div class="network-explore-tools__field">
            <label for="network-layout">{phrase(pageLocale, "Graph arrangement")}</label>
            <select id="network-layout">
              <option value="organic">{phrase(pageLocale, "Organic relationships")}</option>
              <option value="chapter">{phrase(pageLocale, "Chapter clusters")}</option>
            </select>
          </div>
          <div class="network-explore-tools__field">
            <label for="network-color">{phrase(pageLocale, "Character colors")}</label>
            <select id="network-color">
              <option value="chapter">{phrase(pageLocale, "Group by primary chapter")}</option>
              <option value="neutral">{phrase(pageLocale, "Single-color nodes")}</option>
            </select>
          </div>
          <div class="network-explore-tools__field">
            <label for="network-label-density">{phrase(pageLocale, "Node name labels")}</label>
            <select id="network-label-density">
              <option value="focus">{phrase(pageLocale, "Focused figure and direct neighbors")}</option>
              <option value="all">{phrase(pageLocale, "Show all visible names")}</option>
            </select>
          </div>
          <form id="network-search-form" class="network-explore-tools__search" role="search">
            <label for="network-search">{phrase(pageLocale, "Find a character")}</label>
            <div>
              <input type="search" id="network-search" placeholder={phrase(pageLocale, "Search character names")} autocomplete="off" />
              <button type="submit" id="network-find">{phrase(pageLocale, "Find")}</button>
            </div>
            <p id="network-search-status" role="status" aria-live="polite"></p>
          </form>
        </div>
        <div class="network-legend-heading">
          <strong>{phrase(pageLocale, "What the line colors mean")}</strong>
          <span>{phrase(pageLocale, "Relationships are documented ties, not shared factions or dates.")}</span>
        </div>
        <ul class="network-visual__legend" aria-label={phrase(pageLocale, "Relationship color legend")}>
          {Object.entries(RELATIONSHIP_COLORS).map(([key, item]) => (
            <li class={'network-legend--' + key}>
              <strong>{phrase(pageLocale, item.label)}</strong><span>{phrase(pageLocale, item.description)}</span>
            </li>
          ))}
        </ul>
        <div id="network-chapter-legend" class="network-chapter-legend" aria-label={phrase(pageLocale, "Character chapter color legend")} hidden></div>
        <p class="network-chapter-explainer">{phrase(pageLocale, "Chapter filters use the chapter documenting the tie. Node colors show each figure’s first indexed chapter—not allegiance, birthplace, or an exact date. By default, names appear around the selected figure; you can show every name using Node name labels.")}</p>
        <p id="network-graph-status" role="status" aria-live="polite">{phrase(pageLocale, "Loading relationship graph…")}</p>
        <div id="network-canvas" role="img" aria-label={phrase(pageLocale, "Interactive character relationship graph")}></div>
        <aside id="network-inspector" class="network-inspector" aria-labelledby="network-inspector-heading">
          <div class="network-inspector__content">
            <p class="eyebrow" id="network-inspector-kind">{phrase(pageLocale, "Selected character")}</p>
            <h4 id="network-inspector-heading">{phrase(pageLocale, "Character details")}</h4>
            <p id="network-inspector-summary"></p>
            <p id="network-inspector-count"></p>
            <div class="network-inspector__chooser">
              <label for="network-inspector-relation">{phrase(pageLocale, "Inspect a direct relationship")}</label>
              <select id="network-inspector-relation">
                <option value="">{phrase(pageLocale, "Selected character overview")}</option>
              </select>
            </div>
          </div>
          <a id="network-inspector-link" href={withBase('characters/' + initialId + '/')}>{phrase(pageLocale, "Read biography →")}</a>
          <a id="network-inspector-chapter" href={withBase('timeline/')} hidden>{phrase(pageLocale, "Read historical chapter →")}</a>
        </aside>
      </section>
      <p class="network-graph-error" id="network-graph-error" role="status" hidden>{phrase(pageLocale, "The interactive graph could not be loaded. All historical connections remain available in the relationship cards below.")}</p>

      <div class="network-grid" id="network-grid">
        {characterRelationships.map((relation) => {
          const a = byId.get(relation.a);
          const b = byId.get(relation.b);
          if (!a || !b) throw new Error('Unknown character in relationship explorer');
          const title = chapterNames.get(relation.chapterId);
          if (!title) throw new Error('Unknown chapter in relationship explorer');
          return (
            <article
              class="network-edge"
              data-network-edge
              data-a={relation.a}
              data-b={relation.b}
              data-category={relation.category}
              data-chapter={relation.chapterId}
              data-label-a={relation.labelForA}
              data-label-b={relation.labelForB}
            >
              <div class="network-edge__head">
                <span class="network-edge__category">{categoryLabels[relation.category]}</span>
                <span class="network-edge__relation"><span class="network-edge__perspective">{phrase(pageLocale, "Relationship perspective")}</span><strong data-network-label>{a.name}: {relation.labelForA}</strong></span>
              </div>
              <div class="network-edge__person" data-network-person-a>
                <a href={withBase('characters/' + a.id + '/')}>{a.name} ↗</a>
                <button type="button" hidden data-network-focus={a.id} aria-label={phrase(pageLocale, "Focus relationship network on") + " " + a.name}>{phrase(pageLocale, "Focus on")} {a.name}</button>
              </div>
              <div class="network-edge__person" data-network-person-b>
                <a href={withBase('characters/' + b.id + '/')}>{b.name} ↗</a>
                <button type="button" hidden data-network-focus={b.id} aria-label={phrase(pageLocale, "Focus relationship network on") + " " + b.name}>{phrase(pageLocale, "Focus on")} {b.name}</button>
              </div>
              <p>{relation.context}</p>
              <a class="network-edge__chapter" href={withBase('chapters/' + relation.chapterId + '/')}>{phrase(pageLocale, "Historical context:")} {title} →</a>
            </article>
          );
        })}
      </div>
      <p class="network-note">{phrase(pageLocale, "Only documented relationships appear in this atlas; shared chapter appearances do not create connections. Use Relationship cards for complete contextual descriptions.")}</p>
      <div class="network-crosslinks">
        <a class="text-link" href={withBase('characters/')}>{phrase(pageLocale, "All character profiles →")}</a>
        <a class="text-link" href={withBase('timeline/')}>{phrase(pageLocale, "Explore the historical timeline →")}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { phrase, localeForPath } from '../../utils/locale';
  const clientLocale = localeForPath(window.location.pathname);
  import { initializeRelationshipGraph } from '../../scripts/relationship-graph';
  const root = document.querySelector<HTMLElement>('[data-relationship-explorer]');
  if (root) {
    const controls = root.querySelector<HTMLElement>('#network-controls');
    const select = root.querySelector<HTMLSelectElement>('#network-person');
    const type = root.querySelector<HTMLSelectElement>('#network-category');
    const reset = root.querySelector<HTMLButtonElement>('#network-reset');
    const focus = root.querySelector<HTMLElement>('#network-focus');
    const name = root.querySelector<HTMLElement>('#network-focus-name');
    const count = root.querySelector<HTMLElement>('#network-count');
    const profile = root.querySelector<HTMLAnchorElement>('#network-profile');
    const empty = root.querySelector<HTMLElement>('#network-empty');
    const edges = Array.from(root.querySelectorAll<HTMLElement>('[data-network-edge]'));

    if (controls && select && type && reset && focus && name && count && profile && empty) {
      const validPeople = new Set(Array.from(select.options, (option) => option.value));
      const validCategories = new Set(Array.from(type.options, (option) => option.value));
      const restoreFromUrl = () => {
        const params = new URLSearchParams(window.location.search);
        const requested = params.get('person');
        const category = params.get('type');
        select.value = requested && validPeople.has(requested) ? requested : select.options[0]?.value ?? '';
        type.value = category && validCategories.has(category) ? category : '';
      };
      restoreFromUrl();
      const initial = select.value;
      const base = profile.href.slice(0, profile.href.lastIndexOf('/') + 1)
        .replace(/[^/]+\/$/, '');
      const update = (persist = false) => {
        const person = select.value;
        const category = type.value;
        const selected = select.selectedOptions[0];
        name.textContent = selected?.textContent ?? '';
        profile.href = base + encodeURIComponent(person) + '/';
        let visible = 0;
        for (const edge of edges) {
          const isA = edge.dataset.a === person;
          const isB = edge.dataset.b === person;
          const matches = (isA || isB) && (!category || edge.dataset.category === category);
          edge.hidden = !matches;
          if (!matches) continue;
          visible++;
          const a = edge.querySelector<HTMLElement>('[data-network-person-a]');
          const b = edge.querySelector<HTMLElement>('[data-network-person-b]');
          if (a) a.hidden = isA;
          if (b) b.hidden = isB;
          const label = edge.querySelector<HTMLElement>('[data-network-label]');
          if (label) label.textContent = `${selected?.textContent ?? person}: ${isA ? (edge.dataset.labelA ?? '') : (edge.dataset.labelB ?? '')}`;
        }
        count.textContent = visible + ' ' + phrase(clientLocale, visible === 1 ? 'direct connection shown' : 'direct connections shown');
        empty.hidden = visible !== 0;
        if (persist) {
          const url = new URL(window.location.href);
          url.searchParams.set('person', person);
          if (category) url.searchParams.set('type', category);
          else url.searchParams.delete('type');
          if (url.href !== window.location.href) {
            window.history.pushState(null, '', url.pathname + url.search + url.hash);
          }
        }
        root.dispatchEvent(new CustomEvent('relationship:change'));
      };
      select.addEventListener('change', () => update(true));
      type.addEventListener('change', () => update(true));
      reset.addEventListener('click', () => { select.value = initial; type.value = ''; update(true); select.focus(); });
      window.addEventListener('popstate', () => { restoreFromUrl(); update(false); });
      root.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest<HTMLButtonElement>('[data-network-focus]');
        if (!button) return;
        const person = button.dataset.networkFocus;
        if (person && Array.from(select.options).some((option) => option.value === person)) {
          select.value = person;
          update(true);
          select.focus();
        }
      });
      for (const button of root.querySelectorAll<HTMLButtonElement>('[data-network-focus]')) {
        button.hidden = false;
      }
      controls.hidden = false;
      focus.hidden = false;
      update(false);
      void initializeRelationshipGraph(root);
    }
  }
</script>
