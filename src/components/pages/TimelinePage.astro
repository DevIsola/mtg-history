---
const pageLocale = localeForPath(Astro.url.pathname);
const pt = pageLocale === 'pt-BR';
const withBase = (path = '') => localPath(path, pageLocale);

import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterChronology from '../../components/ChapterChronology.astro';
import TimelineArtwork from '../../components/TimelineArtwork.astro';
import { eras as canonicalEras } from '../../data/eras';
import portugueseEras from '../../data/pt-br/eras.json';
const eras = canonicalEras.map(era => pt ? { ...era, ...(portugueseEras as Record<string, { name: string; kicker: string; summary: string }>)[era.id] } : era);
import { historicalEvents as canonical_historicalEvents } from '../../data/events';
import { characters as canonical_characters } from '../../data/characters';
import { getCollection } from 'astro:content';
import { localPath, localeForPath, phrase } from '../../utils/locale';
import { localized } from '../../utils/localization';
const historicalEvents = canonical_historicalEvents.map(record => localized('events', record, pageLocale));

const characters = canonical_characters.map(record => localized('characters', record, pageLocale));


const chapters = (await getCollection(pt ? 'chaptersPt' : 'chapters'))
  .sort((a, b) => a.data.order - b.data.order);
const byEra = new Map(chapters.map((chapter) => [chapter.data.eraId, chapter]));
const characterNames = new Map(characters.map((person) => [person.id, person.name]));

const entries = eras.map((era) => {
  const chapter = byEra.get(era.id);
  const events = historicalEvents.filter((event) => event.chapterId === era.id);
  const people = new Set(events.flatMap((event) => event.characterIds));
  const eraSearch = [
    era.name, era.kicker, era.summary, ...era.sets,
    chapter?.data.chronology.storyPeriod ?? '',
    chapter?.data.chronology.storyDetail ?? '',
    chapter?.data.chronology.publicationHistory ?? '',
  ].join(' ');
  const eventRecords = events.map((event) => ({
    event,
    search: [event.title, event.summary,
      ...event.characterIds.map((id) => characterNames.get(id) ?? ''),
    ].join(' '),
  }));
  const searchText = [eraSearch, ...eventRecords.map(({ search }) => search),
    ...[...people].map((id) => characterNames.get(id) ?? ''),
  ].join(' ');
  return { era, chapter, eventRecords, eraSearch, searchText };
});
---
<BaseLayout locale={pageLocale}
  title={phrase(pageLocale, "Historical timeline explorer")}
  description={phrase(pageLocale, "Explore the historical eras, defining events, characters, and chapter chronology of the Magic Multiverse.")}
>
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">{phrase(pageLocale, "An interactive historical atlas")}</p>
      <h1>{phrase(pageLocale, "A chronology")}<br />{phrase(pageLocale, "of the Multiverse")}</h1>
      <p>{phrase(pageLocale, "An editorial reading order through")} {eras.length} {phrase(pageLocale, "eras. Story chronology and publication history remain distinct.")}</p>
        <div class="atlas-stats" aria-label={phrase(pageLocale, "Archive coverage")}>
          <div><strong>{eras.length}</strong><span>{phrase(pageLocale, "historical eras")}</span></div>
          <div><strong>{chapters.length}</strong><span>{phrase(pageLocale, "published chapters")}</span></div>
          <div><strong>{historicalEvents.length}</strong><span>{phrase(pageLocale, "documented events")}</span></div>
        </div>
    </div>
  </section>

  <section class="atlas-section section-spacing" data-timeline-explorer>
    <div class="page-shell">
      <noscript><style is:inline>.editorial-design .atlas-tools[data-timeline-pending] { display: none; }</style></noscript>
      <div class="atlas-tools" id="timeline-controls" data-timeline-pending inert>
        <div class="atlas-tools__field atlas-tools__field--search">
          <label for="timeline-search">{phrase(pageLocale, "Search history")}</label>
          <input id="timeline-search" type="search" placeholder={phrase(pageLocale, "A person, place, event, or card set...")} autocomplete="off" />
        </div>
        <div class="atlas-tools__field">
          <label for="timeline-era">{phrase(pageLocale, "Filter by historical era")}</label>
          <select id="timeline-era">
            <option value="">{phrase(pageLocale, "All historical eras")}</option>
            {eras.map((era) => <option value={era.id}>{era.chapter} · {era.name}</option>)}
          </select>
        </div>
        <div class="atlas-tools__actions">
          <button type="button" id="timeline-expand" aria-pressed="false">{phrase(pageLocale, "Expand all event lists")}</button>
          <button type="button" id="timeline-reset" disabled>{phrase(pageLocale, "Clear filters")}</button>
        </div>
        <p id="timeline-status" class="atlas-tools__status" role="status" aria-live="polite" aria-atomic="true">{phrase(pageLocale, "Showing {count} eras").replace('{count}', String(eras.length))}</p>
      </div>

      <nav class="atlas-jumps" id="timeline-jumps" aria-label={phrase(pageLocale, "Jump to a historical era")}>
        {eras.map((era) => <a href={'#' + era.id}><span>{era.chapter}</span> {era.name}</a>)}
      </nav>

      <p class="atlas-empty" id="timeline-empty" hidden>{phrase(pageLocale, "No eras match those terms. Try a different search or clear the filters.")}</p>

      <div class="atlas-track atlas-track--editorial">
        {entries.map(({ era, chapter, eventRecords, eraSearch, searchText }) => (
          <article class="atlas-era" id={era.id} data-timeline-era data-id={era.id} data-search={searchText} data-era-search={eraSearch}>
            <div class="atlas-era__rail" aria-hidden="true"><span>{era.chapter}</span><strong>{era.name}</strong><small>{chapter?.data.chronology.storyPeriod}</small></div>
            <div class="atlas-era__content">
              <div class="atlas-era__topline">
                <span>{era.kicker}</span>
                <span>{chapter ? phrase(pageLocale, "Chapter available") : era.status === 'in-progress' ? phrase(pageLocale, "In progress") : phrase(pageLocale, "Planned")}</span>
              </div>
              <h3>{era.name}</h3>
              <p class="atlas-era__summary">{era.summary}</p>
              {chapter && (
                <div class="atlas-era__chronology">
                  <div><span>{phrase(pageLocale, "Story period")}</span><strong>{chapter.data.chronology.storyPeriod}</strong></div>
                  <div><span>{phrase(pageLocale, "In publication")}</span><strong>{chapter.data.chronology.publicationHistory}</strong></div>
                </div>
              )}
              <div class="atlas-era__links">
                {chapter && <a class="atlas-primary-link" href={withBase('chapters/' + chapter.id + '/#chapter-reader')}>{phrase(pageLocale, "Read the chapter →")}</a>}
                <a class="text-link" href={withBase('events/') + '#' + era.id}>{phrase(pageLocale, "Browse events in context →")}</a>
              </div>
              {chapter && <TimelineArtwork chapter={chapter} />}
              {eventRecords.length > 0 && (
                <details class="atlas-era__events" data-timeline-details>
                  <summary><span>{phrase(pageLocale, "Defining historical events")}</span><small data-timeline-event-count>{eventRecords.length} {phrase(pageLocale, "records")}</small></summary>
                  <ol>
                    {eventRecords.map(({ event, search }) => (
                      <li data-timeline-event data-search={search}>
                        <a href={withBase('events/' + event.id + '/')}>
                          <strong>{event.title}</strong>
                          <span>{event.summary}</span>
                          <span class="atlas-event-action">{phrase(pageLocale, "Read event →")}</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </details>
              )}
              <div class="atlas-era__publications">
                <strong>{phrase(pageLocale, "Related publications")}</strong>
                <ul>{era.sets.map((set) => <li>{set}</li>)}</ul>
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="atlas-note">{phrase(pageLocale, "Story-period dates and publication dates describe different timelines. Events within a chapter may overlap with other stories; labels and event groupings are editorial guides, not a claim of exact cross-planar dating.")}</p>
      <a class="text-link" href={withBase('relationships/')}>{phrase(pageLocale, "Explore the people connected by these events →")}</a>
    </div>
  </section>
  <div class="chronology-band"><div class="page-shell"><ChapterChronology chapters={chapters} /></div></div>
</BaseLayout>

<script>
  import { phrase, localeForPath } from '../../utils/locale';
  const clientLocale = localeForPath(window.location.pathname);
  const root = document.querySelector<HTMLElement>('[data-timeline-explorer]');
  if (root) {
    const controls = root.querySelector<HTMLElement>('#timeline-controls');
    const search = root.querySelector<HTMLInputElement>('#timeline-search');
    const eraSelect = root.querySelector<HTMLSelectElement>('#timeline-era');
    const reset = root.querySelector<HTMLButtonElement>('#timeline-reset');
    const expand = root.querySelector<HTMLButtonElement>('#timeline-expand');
    const status = root.querySelector<HTMLElement>('#timeline-status');
    const empty = root.querySelector<HTMLElement>('#timeline-empty');
    const jumps = root.querySelector<HTMLElement>('#timeline-jumps');
    const records = Array.from(root.querySelectorAll<HTMLElement>('[data-timeline-era]'));
    const details = Array.from(root.querySelectorAll<HTMLDetailsElement>('[data-timeline-details]'));
    const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

    if (controls && search && eraSelect && reset && expand && status && empty && jumps) {
      const indexed = records.map((element) => ({
        element,
        text: normalize(element.dataset.search ?? ''),
        eraText: normalize(element.dataset.eraSearch ?? ''),
        details: element.querySelector<HTMLDetailsElement>('[data-timeline-details]'),
        events: Array.from(element.querySelectorAll<HTMLElement>('[data-timeline-event]'))
          .map((row) => ({ row, text: normalize(row.dataset.search ?? '') })),
      }));

      const syncExpand = () => {
        const visible = details.filter((detail) => !detail.closest<HTMLElement>('[data-timeline-era]')?.hidden);
        const allOpen = visible.length > 0 && visible.every((detail) => detail.open);
        expand.setAttribute('aria-pressed', String(allOpen));
        expand.textContent = phrase(clientLocale, allOpen ? 'Collapse all event lists' : 'Expand all event lists');
      };

      const update = () => {
        const words = normalize(search.value).split(/\s+/).filter(Boolean);
        const selected = eraSelect.value;
        let count = 0;
        for (const record of indexed) {
          const match = (!selected || record.element.dataset.id === selected)
            && words.every((word) => record.text.includes(word));
          record.element.hidden = !match;
          if (!match) continue;
          count++;

          // When an event matches but the era itself does not, surface the
          // matching records rather than opening a lengthy unfiltered list.
          const eraMatches = words.every((word) => record.eraText.includes(word));
          const matchingEvents = record.events.filter(({ text }) =>
            words.every((word) => text.includes(word)));
          const narrowEvents = words.length > 0 && !eraMatches && matchingEvents.length > 0;
          for (const { row } of record.events) {
            row.hidden = narrowEvents && !matchingEvents.some((match) => match.row === row);
          }
          const countLabel = record.details?.querySelector<HTMLElement>('[data-timeline-event-count]');
          if (countLabel) {
            countLabel.textContent = narrowEvents
              ? matchingEvents.length + ' ' + phrase(clientLocale, 'matching records')
              : record.events.length + ' ' + phrase(clientLocale, 'records');
          }
          if (narrowEvents && record.details) record.details.open = true;
        }
        status.textContent = phrase(clientLocale, "Showing {count} of {total} historical eras").replace('{count}', String(count)).replace('{total}', String(records.length));
        empty.hidden = count > 0;
        jumps.hidden = Boolean(selected || words.length);
        reset.disabled = !(selected || words.length);
        syncExpand();
      };
      search.addEventListener('input', update);
      eraSelect.addEventListener('change', update);
      reset.addEventListener('click', () => {
        search.value = '';
        eraSelect.value = '';
        update();
        search.focus();
      });
      for (const detail of details) detail.addEventListener('toggle', syncExpand);
      expand.addEventListener('click', () => {
        const open = expand.getAttribute('aria-pressed') !== 'true';
        for (const detail of details) {
          if (!detail.closest<HTMLElement>('[data-timeline-era]')?.hidden) detail.open = open;
        }
        syncExpand();
      });
      controls.removeAttribute('inert');
      controls.removeAttribute('data-timeline-pending');
      update();
    }
  }
</script>
