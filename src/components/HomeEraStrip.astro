---
import { getCollection } from 'astro:content';
import { localeForPath, localPath, phrase } from '../utils/locale';
interface Props { locale?: 'en' | 'pt-BR'; }
const { locale = localeForPath(Astro.url.pathname) } = Astro.props;
const t = (english: string) => phrase(locale, english);
const chapters = (await getCollection(locale === 'pt-BR' ? 'chaptersPt' : 'chapters')).sort((a, b) => a.data.order - b.data.order);
---
<section class="home-story" aria-labelledby="home-story-heading">
  <div class="page-shell">
    <div class="home-story__intro">
      <div><p class="eyebrow">{t('The story so far')}</p><h2 id="home-story-heading">{t('A Multiverse of stories.')}</h2></div>
      <p>{t('From the Thran to the Omenpaths, follow the chapters in editorial reading order. Story chronology and publication history remain distinct.')}</p>
      <a class="text-link" href={localPath('timeline/', locale)}>{t('View full timeline')} →</a>
    </div>
    <nav class="home-era-strip" aria-label={t('Chapters in reading order')}>
      <ol>{chapters.map(chapter => <li><a href={localPath('chapters/' + chapter.id + '/', locale)}><span>{String(chapter.data.order).padStart(2, '0')}</span><strong>{chapter.data.title}</strong></a></li>)}</ol>
    </nav>
  </div>
</section>
