
---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import HistoricalCard from '../../components/HistoricalCard.astro';
import EventEvidence from '../../components/EventEvidence.astro';
import UnverifiedEventNotice from '../../components/UnverifiedEventNotice.astro';

import {
  historicalEvents,
  type HistoricalEvent,
} from '../../data/events';

import { characters } from '../../data/characters';
import { withBase } from '../../utils/paths';
import { chapterCardUse } from '../../utils/card-printings';
import { eventProvenance } from '../../data/event-provenance.mjs';
import manualEventReviews from '../../data/manual-event-review.json';

type Chapter = CollectionEntry<'chapters'>;
type Card = ReturnType<typeof chapterCardUse>;

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  const cardCatalog = new Map((await getCollection('cards')).map(({ id, data }) => [id, data]));

  return historicalEvents.map((event) => {
    const chapter = chapters.find(
      (entry) => entry.id === event.chapterId
    );

    if (!chapter) {
      throw new Error(
        `Missing chapter "${event.chapterId}" for event "${event.id}"`
      );
    }

    const index = chapter.data.cardIds.findIndex((reference) => reference.id === event.cardId);
    if (index < 0) throw new Error(`Event ${event.id}: card not curated in ${chapter.id}`);
    const card = chapterCardUse(chapter, index, cardCatalog);

    for (const id of event.characterIds) {
      if (!characters.some((character) => character.id === id)) {
        throw new Error(
          `Unknown character "${id}" in event "${event.id}"`
        );
      }
    }

    return {
      params: { id: event.id },
      props: { event, chapter, card },
    };
  });
}

const { event, chapter, card } = Astro.props as {
  event: HistoricalEvent;
  chapter: Chapter;
  card: Card;
};

const people = event.characterIds.map((id) => {
  const character = characters.find(
    (entry) => entry.id === id
  );

  if (!character) {
    throw new Error(`Unknown historical character: ${id}`);
  }

  return character;
});

const provenance = eventProvenance[event.id];
const manualReview = Object.values(manualEventReviews).find(
  (item) => item.eventId === event.id
);
if (manualReview && provenance) {
  throw new Error(`Event ${event.id}: manual review conflicts with reviewed provenance`);
}

const currentIndex = historicalEvents.findIndex(
  (entry) => entry.id === event.id
);

const previousEvent =
  currentIndex > 0
    ? historicalEvents[currentIndex - 1]
    : undefined;

const nextEvent =
  currentIndex >= 0 &&
  currentIndex < historicalEvents.length - 1
    ? historicalEvents[currentIndex + 1]
    : undefined;
---

<BaseLayout
  title={event.title}
  description={event.summary}
  printingId={event.cardId}
>
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">
        Historical event
        {' · '}
        {chapter.data.chronology.storyPeriod}
      </p>

      <h1>{event.title}</h1>
      <p>{event.summary}</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="page-shell">

      <a
        class="text-link"
        href={withBase('events/')}
      >
        ← All historical events
      </a>

      <div class="historical-event-detail">
        <div class="historical-event-detail__main">

          <p class="eyebrow">
            The historical record
          </p>

          <h2>
            {event.title}
          </h2>

          <div class="historical-event-detail__narrative">
            {event.narrative.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          {provenance && <EventEvidence entry={provenance} />}
          {manualReview && <UnverifiedEventNotice entry={manualReview} />}

          <section class="historical-event-detail__related">
            <p class="eyebrow">
              Connected chapter
            </p>

            <a
              class="historical-event-detail__chapter"
              href={withBase(`chapters/${chapter.id}/`)}
            >
              <span>
                Chapter {String(chapter.data.order).padStart(2, '0')}
              </span>

              <strong>{chapter.data.title}</strong>

              <span aria-hidden="true">→</span>
            </a>
          </section>

          {people.length > 0 && (
          <section class="historical-event-detail__related">
            <p class="eyebrow">
              Figures involved
            </p>

            <h3>Connected characters</h3>

            <ul class="historical-event-detail__people">
              {people.map((person) => (
                <li>
                  <a
                    href={withBase(`characters/${person.id}/`)}
                  >
                    <strong>{person.name}</strong>
                    <span>{person.title}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
          )}

        </div>

        <aside class="historical-event-detail__aside">
          <p class="eyebrow">
            From the illustrated archive
          </p>

          <HistoricalCard card={card} />

          <a
            class="text-link"
            href={withBase(`archive/#${chapter.id}`)}
          >
            Browse this chapter's cards →
          </a>
        </aside>
      </div>

      <nav
        class="historical-event-pagination"
        aria-label="Previous and next historical events"
      >
        {previousEvent && (
          <a
            class="historical-event-pagination__previous"
            href={withBase(`events/${previousEvent.id}/`)}
          >
            <span>← Previous event</span>
            <strong>{previousEvent.title}</strong>
          </a>
        )}

        {nextEvent && (
          <a
            class="historical-event-pagination__next"
            href={withBase(`events/${nextEvent.id}/`)}
          >
            <span>Next event →</span>
            <strong>{nextEvent.title}</strong>
          </a>
        )}
      </nav>

    </div>
  </section>
</BaseLayout>
