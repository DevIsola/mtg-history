---
import BaseLayout from '../layouts/BaseLayout.astro';
import { eras } from '../data/eras';
import { withBase } from '../utils/paths';

const highlighted = eras.slice(0, 3);
---
<BaseLayout
  title="A history written across worlds"
  description="Travel through the history of Magic: The Gathering. Explore its events, major expansions, and the cards that preserve their stories."
>
  <section class="hero">
    <div class="hero__starlight" aria-hidden="true"></div>
    <div class="hero__emblem" aria-hidden="true">
      <div class="hero__emblem-inner"><span>✧</span></div>
    </div>
    <div class="page-shell hero__content">
      <p class="eyebrow eyebrow--light"><span class="eyebrow-line"></span>An independent history of Magic: The Gathering<span class="eyebrow-line"></span></p>
      <h1>Every world<br />has a <em>history.</em></h1>
      <p class="hero__lead">
        Before legends became cards, they were stories. Discover the wars,
        wanderers, and turning points that shaped the Multiverse.
      </p>
      <div class="hero__actions">
        <a class="button button--gold" href={withBase('timeline/')}>Explore the timeline <span aria-hidden="true">→</span></a>
        <a class="button button--outline" href={withBase('about/')}>About the archive</a>
      </div>
      <p class="hero__aside">A chronological reading experience · Illustrated by the cards themselves</p>
    </div>
    <div class="hero__bottom" aria-hidden="true"><span>✦</span></div>
  </section>

  <section class="intro-section section-spacing" aria-labelledby="intro-heading">
    <div class="page-shell intro-grid">
      <div class="intro-heading">
        <p class="eyebrow">The archive</p>
        <h2 id="intro-heading" class="section-title">Not simply a list<br />of <em>expansions.</em></h2>
      </div>
      <div class="intro-copy">
        <p class="lead-copy">This is a history of the Multiverse told through its defining moments.</p>
        <p>Each chapter connects the events of Magic's story to the sets that revealed them—and to selected cards whose art and flavor text bring those moments to life.</p>
        <p>Follow the story in narrative order, then discover when each piece of that history appeared in the real world.</p>
        <a class="text-link" href={withBase('about/')}>How the archive is organized <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="eras-section section-spacing" aria-labelledby="eras-heading">
    <div class="page-shell">
      <div class="section-topline">
        <div>
          <p class="eyebrow">Begin the journey</p>
          <h2 id="eras-heading" class="section-title">The first <em>chapters</em></h2>
        </div>
        <a class="text-link" href={withBase('timeline/')}>View complete timeline <span aria-hidden="true">→</span></a>
      </div>
      <div class="era-card-grid">
        {highlighted.map((era) => (
          <a class="era-card" href={withBase(`timeline/#${era.id}`)}>
            <span class="era-card__top"><span>Chapter {era.chapter}</span><span aria-hidden="true">↗</span></span>
            <span class="era-card__ornament" aria-hidden="true">✧</span>
            <span class="era-card__kicker">{era.kicker}</span>
            <strong>{era.name}</strong>
            <span class="era-card__description">{era.summary}</span>
            <span class="era-card__bottom">Explore this era <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="editorial-section section-spacing" aria-labelledby="editorial-heading">
    <div class="page-shell editorial-grid">
      <div class="editorial-mark" aria-hidden="true"><span>✦</span><span>MTG</span><span>1993 — ∞</span></div>
      <div>
        <p class="eyebrow">An illustrated chronicle</p>
        <h2 id="editorial-heading" class="section-title">Cards as <em>historical artifacts.</em></h2>
        <p>We'll feature a small selection of cards in each chapter, chosen because they depict a scene, identify an important figure, or preserve a piece of the narrative in their flavor text.</p>
        <p class="muted-copy">The archive now connects historical chapters, illustrated card references, and character profiles across the history of the Multiverse.</p>
      </div>
    </div>
  </section>
</BaseLayout>
