---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import HomepageArtwork from '../components/HomepageArtwork.astro';
import HomeEraStrip from '../components/HomeEraStrip.astro';
import { eras } from '../data/eras';
import { withBase } from '../utils/paths';

const highlighted = eras.slice(0, 4);
const counts = {
  chapters: (await getCollection('chapters')).length,
  events: (await getCollection('events')).length,
  characters: (await getCollection('characters')).length,
  relationships: (await getCollection('relationships')).length,
};
---
<BaseLayout
  title="A history written across worlds"
  description="Travel through the history of Magic: The Gathering. Explore its events, major expansions, and the cards that preserve their stories."
>
  <section class="hero homepage-hero">
    <div class="page-shell hero__content homepage-hero__grid">
      <div class="homepage-hero__copy">
        <p class="eyebrow eyebrow--light">An independent illustrated history of Magic: The Gathering</p>
        <h1>Every world<br />has a history.</h1>
        <p class="hero__lead">Follow the wars, discoveries, and people that shaped the Multiverse. Read in story order, then explore the actual cards and publications that preserve its history.</p>
        <div class="hero__actions">
          <a class="button button--gold" href={withBase('chapters/thran/')}>Start reading <span aria-hidden="true">→</span></a>
          <a class="button button--outline" href={withBase('timeline/')}>Explore the timeline</a>
        </div>
        <p class="hero__aside">Story chronology is distinct from publication history.</p>
      </div>

    </div>
  </section>

  <section class="homepage-numbers" aria-label="Documented archive coverage">
    <dl class="page-shell">
      <div><dt>Chapters</dt><dd>{counts.chapters}</dd></div>
      <div><dt>Historical events</dt><dd>{counts.events}</dd></div>
      <div><dt>Characters</dt><dd>{counts.characters}</dd></div>
      <div><dt>Documented ties</dt><dd>{counts.relationships}</dd></div>
    </dl>
  </section>

  <HomeEraStrip />

<section
  class="journey-section section-spacing"
  aria-labelledby="journey-heading"
>
  <div class="page-shell">
    <div class="journey-intro">
      <p class="eyebrow">Choose your path</p>

      <h2 id="journey-heading" class="section-title">
        Ways to explore
        <em> the Multiverse.</em>
      </h2>

      <p>
        Follow the events that shaped history,
        meet those who lived through them,
        or examine the cards that preserve their stories.
      </p>
    </div>

    <div class="journey-grid homepage-journey-grid">
      <a class="journey-card" href={withBase('timeline/')}>
        <span class="journey-card__number">01 / HISTORY</span>
        <span class="journey-card__symbol" aria-hidden="true">✧</span>

        <h3>Follow the story</h3>

        <p>
          Travel through major historical eras,
          from the fall of the Thran to the Mending
          and beyond.
        </p>

        <span class="journey-card__action">
          Explore the timeline →
        </span>
      </a>

      <a class="journey-card" href={withBase('characters/')}>
        <span class="journey-card__number">02 / PEOPLE</span>
        <span class="journey-card__symbol" aria-hidden="true">✧</span>

        <h3>Meet the legends</h3>

        <p>
          Discover the figures behind the great
          conflicts, their transformations, and
          their connections across chapters.
        </p>

        <span class="journey-card__action">
          Browse characters →
        </span>
      </a>

      <a class="journey-card" href={withBase('archive/')}>
        <span class="journey-card__number">03 / ARTIFACTS</span>
        <span class="journey-card__symbol" aria-hidden="true">✧</span>

        <h3>Explore the archive</h3>

        <p>
          Browse illustrated Magic cards as
          historical records of the people,
          events, and places they depict.
        </p>

        <span class="journey-card__action">
          Open the archive →
        </span>
      </a>
      <a class="journey-card" href={withBase('relationships/')}>
        <span class="journey-card__number">04 / CONNECTIONS</span>
        <span class="journey-card__symbol" aria-hidden="true">✧</span>
        <h3>Trace relationships</h3>
        <p>Examine documented alliances, rivalries, family ties and mentorships without conflating shared chapters with proven connections.</p>
        <span class="journey-card__action">Open the relationship atlas →</span>
      </a>
    </div>

    <p class="journey-discover-link">
      <a
        class="text-link"
        href={withBase('discover/')}
      >
        Or search the entire encyclopedia →
      </a>
    </p>

  </div>
</section>

  <section class="eras-section section-spacing" aria-labelledby="eras-heading">
    <div class="page-shell">
      <div class="section-topline">
        <div>
          <p class="eyebrow">Begin the journey</p>
          <h2 id="eras-heading" class="section-title">The first <em>chapters</em></h2>
        </div>
        <a class="text-link" href={withBase('timeline/')}>View complete timeline <span aria-hidden="true">→</span></a>
      </div>
      <div class="era-card-grid homepage-era-grid">
        {highlighted.map((era) => (
          <article class="era-card homepage-era-card">
            <HomepageArtwork chapterId={era.id} variant="tile" />
            <div class="homepage-era-card__text">
              <span class="era-card__kicker">Chapter {era.chapter} · {era.kicker}</span>
              <h3>{era.name}</h3>
              <p>{era.summary}</p>
              <a class="homepage-era-card__read" href={withBase(`chapters/${era.id}/`)}>Read historical chapter →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="intro-section section-spacing" aria-labelledby="intro-heading">
    <div class="page-shell intro-grid">
      <div class="intro-heading">
        <p class="eyebrow">The archive</p>
        <h2 id="intro-heading" class="section-title">Not simply a list<br />of <em>expansions.</em></h2>
      </div>
      <div class="intro-copy">
      <HomepageArtwork chapterId="war-of-the-spark" variant="editorial" />

        <p class="lead-copy">This is a history of the Multiverse told through its defining moments.</p>
        <p>Each chapter connects the events of Magic's story to the sets that revealed them—and to selected cards whose art and flavor text bring those moments to life.</p>
        <p>Follow the story in narrative order, then discover when each piece of that history appeared in the real world.</p>
        <a class="text-link" href={withBase('about/')}>How the archive is organized <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>









  <section class="editorial-section section-spacing" aria-labelledby="editorial-heading">
    <div class="page-shell editorial-grid">
      <HomepageArtwork chapterId="omenpaths" variant="editorial" />
      <div>
        <p class="eyebrow">An illustrated chronicle</p>
        <h2 id="editorial-heading" class="section-title">Cards as <em>historical artifacts.</em></h2>
        <p>We'll feature a small selection of cards in each chapter, chosen because they depict a scene, identify an important figure, or preserve a piece of the narrative in their flavor text.</p>
        <p class="muted-copy">The archive now connects historical chapters, illustrated card references, and character profiles across the history of the Multiverse.</p>
      </div>
    </div>
  </section>
</BaseLayout>
