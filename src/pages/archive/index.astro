
---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
import { chapterCardUse, cardImageUrl, cardImageSrcset, cardScryfallUrl } from '../../utils/card-printings';

const chapters = (await getCollection('chapters'))
  .sort((a, b) => a.data.order - b.data.order);

const cardCatalog = new Map((await getCollection('cards')).map(({ id, data }) => [id, data]));

const sections = chapters
  .filter((chapter) => chapter.data.cardIds.length > 0)
  .map((chapter) => ({
    id: chapter.id,
    title: chapter.data.title,
    order: chapter.data.order,
    cards: chapter.data.cardIds.map((_, index) => {
      const card = chapterCardUse(chapter, index, cardCatalog);
      return { ...card, imageUrl: cardImageUrl(card.scryfallId), imageSrcset: cardImageSrcset(card.scryfallId), cardUrl: cardScryfallUrl(card) };
    }),
  }));

const cardCount = sections.reduce(
  (total, section) => total + section.cards.length,
  0
);


const setNames: Record<string, string> = {
  apc: 'Apocalypse',
  bro: "The Brothers' War",
  c14: 'Commander 2014',
  c18: 'Commander 2018',
  cmr: 'Commander Legends',
  dmu: 'Dominaria United',
  dom: 'Dominaria',
  fut: 'Future Sight',
  jud: 'Judgment',
  lgn: 'Legions',
  mh1: 'Modern Horizons',
  nms: 'Nemesis',
  ody: 'Odyssey',
  ons: 'Onslaught',
  plc: 'Planar Chaos',
  pls: 'Planeshift',
  scg: 'Scourge',
  tor: 'Torment',
  tsp: 'Time Spiral',
};

const formatSet = (code: string): string => {
  const normalized = code.toLowerCase();
  const name = setNames[normalized] ?? normalized.toUpperCase();

  return `${name} [${normalized.toUpperCase()}]`;
};

const setCodes = [
  ...new Set(
    sections.flatMap((section) =>
      section.cards.map((card) => card.setCode.toLowerCase())
    )
  ),
].sort((a, b) => formatSet(a).localeCompare(formatSet(b)));

---

<BaseLayout
  title="Illustrated archive"
  description="Search and browse the cards illustrating the history of Magic: The Gathering."
>
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">
        The historical collection
      </p>

      <h1>The illustrated <em>archive.</em></h1>

      <p>
        Every card is a fragment of history.
        Explore the illustrations behind the stories,
        organized by historical chapter.
      </p>
    </div>
  </section>

  <section class="section-spacing archive-directory">
    <div class="page-shell">

      <div class="archive-directory__intro">
        <p class="eyebrow">Cards as historical records</p>

        <h2 class="section-title">
          An archive of <em>moments.</em>
        </h2>

        <p>
          {cardCount} illustrated references across{' '}
          {sections.length} historical chapters.
          Each card links to its printing and the
          chapter where its story is told.
        </p>
      </div>

      <div class="archive-overview" aria-label="Collection coverage">
        <div><strong>{cardCount}</strong><span>curated cards</span></div>
        <div><strong>{sections.length}</strong><span>historical chapters</span></div>
        <div><strong>{setCodes.length}</strong><span>illustrated sets</span></div>
      </div>

      <!-- Progressive enhancement: hidden without JavaScript -->
      <div
        id="archive-filters"
        class="archive-filters"
        hidden
      >
        <div class="archive-filters__heading">
          <h3>Explore the collection</h3>
          <p>Search the historical records or narrow the collection.</p>
        </div>

        <div class="archive-filters__grid">
          <div class="archive-filter-field">
            <label for="archive-search">Search the archive</label>

            <input
              id="archive-search"
              type="search"
              placeholder="Card, character, artist, event..."
              autocomplete="off"
            />
          </div>

          <div class="archive-filter-field">
            <label for="archive-chapter">Historical chapter</label>

            <select id="archive-chapter">
              <option value="">All chapters</option>

              {sections.map((section) => (
                <option value={section.id}>
                  {String(section.order).padStart(2, '0')}
                  {' — '}
                  {section.title}
                </option>
              ))}
            </select>
          </div>

          <div class="archive-filter-field">
            <label for="archive-set">Card set</label>

            <select id="archive-set">
              <option value="">All sets</option>

              {setCodes.map((code) => (
                <option value={code}>
                  {formatSet(code)}
                </option>
              ))}
            </select>
          </div>
          <div class="archive-filter-field">
            <label for="archive-sort">Sort within chapters</label>
            <select id="archive-sort">
              <option value="editorial">Curated story order</option>
              <option value="title">Card name A–Z</option>
              <option value="set">Card set A–Z</option>
            </select>
          </div>
        </div>

        <div class="archive-filters__footer">
          <p
            id="archive-filter-status"
            role="status"
            aria-live="polite"
            aria-atomic="true"
          >
            Showing {cardCount} of {cardCount} illustrated references
          </p>

          <div class="archive-view-tools" role="group" aria-label="Card layout">
            <button class="archive-view-button" type="button" data-archive-view="grid" aria-pressed="true">Gallery</button>
            <button class="archive-view-button" type="button" data-archive-view="compact" aria-pressed="false">Compact</button>
          </div>
          <button
            id="archive-reset"
            type="button"
            disabled
          >
            Clear filters
          </button>
        </div>
      </div>

      <nav
        id="archive-jump-links"
        class="archive-jump-links"
        aria-label="Browse archive by chapter"
      >
        {sections.map((section) => (
          <a href={`#${section.id}`}>
            {String(section.order).padStart(2, '0')}
            {' · '}
            {section.title}
          </a>
        ))}
      </nav>

      <p
        id="archive-no-results"
        class="archive-no-results"
        hidden
      >
        No illustrated references match these filters.
        Try another search or clear your selections.
      </p>

      {sections.map((section) => (
        <section
          id={section.id}
          class="archive-era"
          data-archive-section
          aria-labelledby={`archive-heading-${section.id}`}
        >
          <div class="archive-era__heading">
            <div>
              <p class="eyebrow">
                Chapter {String(section.order).padStart(2, '0')}
              </p>

              <h2 id={`archive-heading-${section.id}`}>
                {section.title}
              </h2>

              <p>
                {section.cards.length} illustrated
                historical references
              </p>
            </div>

            <a
              class="text-link"
              href={withBase(`chapters/${section.id}/`)}
            >
              Read chapter →
            </a>
          </div>

          <div class="archive-card-grid">
            {section.cards.map((card) => (
              <article
                class="archive-card"
                data-archive-card
                data-canonical-id={card.scryfallId}
                data-chapter={section.id}
                data-set={card.setCode.toLowerCase()}
                data-card-title={card.name}
                data-search={`${section.title} ${card.name} ${card.significance} ${card.artist} ${formatSet(card.setCode)}`}
              >
                <a
                  class="archive-card__image"
                  href={card.cardUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${card.name} on Scryfall`}
                >
                  <img
                    src={card.imageUrl}
                    srcset={card.imageSrcset}
                    sizes="(max-width: 600px) 85vw, (max-width: 900px) 45vw, 320px"
                    alt={`${card.name}, illustrated by ${card.artist}`}
                    width="488"
                    height="680"
                    loading="lazy"
                    decoding="async"
                  />
                </a>

                <div class="archive-card__body">
                  <span class="archive-card__set">
                    {formatSet(card.setCode)}
                    {' · '}
                    #{card.collectorNumber}
                  </span>

                  <h3>{card.name}</h3>

                  <span class="archive-card__classification">Illustrative reference · editorial interpretation</span>
                  <p>{card.significance}</p>

                  <span class="archive-card__artist">
                    Illustrated by {card.artist}
                  </span>

                  <a
                    class="archive-card__chapter"
                    href={withBase(
                      `chapters/${section.id}/`
                    )}
                  >
                    Discover its history →
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const panel = document.querySelector<HTMLElement>('#archive-filters');
  const search = document.querySelector<HTMLInputElement>('#archive-search');
  const chapter = document.querySelector<HTMLSelectElement>('#archive-chapter');
  const set = document.querySelector<HTMLSelectElement>('#archive-set');
  const sort = document.querySelector<HTMLSelectElement>('#archive-sort');
  const reset = document.querySelector<HTMLButtonElement>('#archive-reset');
  const status = document.querySelector<HTMLElement>('#archive-filter-status');
  const empty = document.querySelector<HTMLElement>('#archive-no-results');
  const jumpLinks = document.querySelector<HTMLElement>('#archive-jump-links');

  const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-archive-view]'));
  const directory = document.querySelector<HTMLElement>('.archive-directory');

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-archive-card]')
  );

  const sections = Array.from(
    document.querySelectorAll<HTMLElement>('[data-archive-section]')
  );

  const normalize = (value: string) =>
    value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();

  if (
    panel &&
    search &&
    chapter &&
    set &&
    sort &&
    directory &&
    reset &&
    status &&
    empty &&
    jumpLinks
  ) {
    panel.hidden = false;

    const editorialOrder = new Map(sections.map((section) => [
      section,
      Array.from(section.querySelectorAll<HTMLElement>('[data-archive-card]')),
    ]));

    const applySort = () => {
      for (const [section, original] of editorialOrder) {
        const sorted = [...original];
        if (sort.value === 'title') {
          sorted.sort((a, b) => (a.dataset.cardTitle ?? '').localeCompare(b.dataset.cardTitle ?? ''));
        } else if (sort.value === 'set') {
          sorted.sort((a, b) => (a.dataset.set ?? '').localeCompare(b.dataset.set ?? '') ||
            (a.dataset.cardTitle ?? '').localeCompare(b.dataset.cardTitle ?? ''));
        }
        const grid = section.querySelector<HTMLElement>('.archive-card-grid');
        if (grid) sorted.forEach((card) => grid.appendChild(card));
      }
    };

    for (const button of viewButtons) {
      button.addEventListener('click', () => {
        const compact = button.dataset.archiveView === 'compact';
        directory.classList.toggle('archive-directory--compact', compact);
        viewButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        applyFilters();
      });
    }

    const applyFilters = () => {
      const query = normalize(search.value);
      const selectedChapter = chapter.value;
      const selectedSet = set.value;

      const isFiltering =
        query !== '' ||
        selectedChapter !== '' ||
        selectedSet !== '';

      let visibleCount = 0;

      for (const card of cards) {
        const searchText = normalize(
          card.dataset.search ?? ''
        );

        const matchesQuery =
          query === '' || searchText.includes(query);

        const matchesChapter =
          selectedChapter === '' ||
          card.dataset.chapter === selectedChapter;

        const matchesSet =
          selectedSet === '' ||
          card.dataset.set === selectedSet;

        const matches =
          matchesQuery &&
          matchesChapter &&
          matchesSet;

        card.hidden = !matches;

        if (matches) {
          visibleCount++;
        }
      }

      for (const section of sections) {
        const sectionCards = section.querySelectorAll<HTMLElement>(
          '[data-archive-card]'
        );

        section.hidden = !Array.from(sectionCards).some(
          (card) => !card.hidden
        );
      }

      jumpLinks.hidden = isFiltering;
      empty.hidden = visibleCount !== 0;
      reset.disabled = !(isFiltering || sort.value !== 'editorial' ||
        directory.classList.contains('archive-directory--compact'));

      status.textContent =
        `Showing ${visibleCount} of ${cards.length} illustrated references`;
    };

    sort.addEventListener('change', () => { applySort(); applyFilters(); });
    applySort();
    search.addEventListener('input', applyFilters);
    chapter.addEventListener('change', applyFilters);
    set.addEventListener('change', applyFilters);

    reset.addEventListener('click', () => {
      search.value = '';
      chapter.value = '';
      set.value = '';
      sort.value = 'editorial';
      applySort();
      directory.classList.remove('archive-directory--compact');
      for (const button of viewButtons) {
        button.setAttribute('aria-pressed', String(button.dataset.archiveView === 'grid'));
      }

      applyFilters();
      search.focus();
    });

    applyFilters();
  }
</script>
