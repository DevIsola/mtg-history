
---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';

const chapters = (await getCollection('chapters'))
  .sort((a, b) => a.data.order - b.data.order);

const sections = chapters
  .filter((chapter) => chapter.data.cards.length > 0)
  .map((chapter) => ({
    id: chapter.id,
    title: chapter.data.title,
    order: chapter.data.order,
    cards: chapter.data.cards.map((card) => {
      const id = card.scryfallId.toLowerCase();

      return {
        ...card,
        imageUrl:
          `https://cards.scryfall.io/normal/front/${id[0]}/${id[1]}/${id}.jpg`,
        cardUrl:
          `https://scryfall.com/card/${card.setCode}/${card.collectorNumber}`,
      };
    }),
  }));

const cardCount = sections.reduce(
  (total, section) => total + section.cards.length,
  0
);
---

<BaseLayout
  title="Illustrated archive"
  description="Browse the Magic cards that illustrate major events, figures, and periods in the history of the Multiverse."
>
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">
        The historical collection
      </p>
      <h1>The illustrated <em>archive.</em></h1>
      <p>
        Every card is a fragment of history.
        Explore the illustrations behind the stories,
        organized by historical chapter.
      </p>
    </div>
  </section>

  <section class="section-spacing archive-directory">
    <div class="page-shell">
      <div class="archive-directory__intro">
        <p class="eyebrow">Cards as historical records</p>

        <h2 class="section-title">
          An archive of <em>moments.</em>
        </h2>

        <p>
          {cardCount} illustrated references across
          {' '}{sections.length} historical chapters.
          Each card links to its original printing
          and the chapter where it appears.
        </p>
      </div>

      <nav
        class="archive-jump-links"
        aria-label="Browse archive by chapter"
      >
        {sections.map((section) => (
          <a href={`#${section.id}`}>
            {String(section.order).padStart(2, '0')}
            {' · '}
            {section.title}
          </a>
        ))}
      </nav>

      {sections.map((section) => (
        <section
          id={section.id}
          class="archive-era"
          aria-labelledby={`archive-heading-${section.id}`}
        >
          <div class="archive-era__heading">
            <div>
              <p class="eyebrow">
                Chapter {String(section.order).padStart(2, '0')}
              </p>

              <h2 id={`archive-heading-${section.id}`}>
                {section.title}
              </h2>

              <p>
                {section.cards.length} illustrated
                historical references
              </p>
            </div>

            <a
              class="text-link"
              href={withBase(`chapters/${section.id}/`)}
            >
              Read chapter →
            </a>
          </div>

          <div class="archive-card-grid">
            {section.cards.map((card) => (
              <article class="archive-card">
                <a
                  class="archive-card__image"
                  href={card.cardUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`View ${card.name} on Scryfall`}
                >
                  <img
                    src={card.imageUrl}
                    alt={`${card.name}, illustrated by ${card.artist}`}
                    width="488"
                    height="680"
                    loading="lazy"
                    decoding="async"
                  />
                </a>

                <div class="archive-card__body">
                  <span class="archive-card__set">
                    {card.setCode.toUpperCase()}
                    {' · '}
                    #{card.collectorNumber}
                  </span>

                  <h3>{card.name}</h3>

                  <p>{card.significance}</p>

                  <span class="archive-card__artist">
                    Illustrated by {card.artist}
                  </span>

                  <a
                    class="archive-card__chapter"
                    href={withBase(
                      `chapters/${section.id}/`
                    )}
                  >
                    Discover its history →
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
