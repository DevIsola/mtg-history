
---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import HistoricalCard from '../../components/HistoricalCard.astro';
import { characters } from '../../data/characters';
import type { CharacterProfile } from '../../data/characters';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return characters.map((profile) => ({
    params: { id: profile.id },
    props: { profile },
  }));
}

const { profile } = Astro.props as {
  profile: CharacterProfile;
};

const chapters = await getCollection('chapters');

const chaptersById = new Map(
  chapters.map((chapter) => [chapter.id, chapter])
);

const relatedChapters = profile.chapterIds
  .map((id) => chaptersById.get(id))
  .filter(
    (chapter): chapter is CollectionEntry<'chapters'> =>
      chapter !== undefined
  )
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={profile.name}
  description={profile.summary}
>
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">
        Historical character · {profile.origin}
      </p>

      <h1>{profile.name}</h1>
      <p>{profile.title}</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="page-shell">
      <a
        class="text-link"
        href={withBase('characters/')}
      >
        ← All historical characters
      </a>

      <div class="character-profile__layout">
        <div class="character-profile__main">
          <div class="character-profile__facts">
            <div>
              <span>Home plane</span>
              <strong>{profile.origin}</strong>
            </div>

            <div>
              <span>Historical role</span>
              <strong>{profile.role}</strong>
            </div>
          </div>

          <article class="character-profile__biography">
            <p class="eyebrow">The historical record</p>

            <h2>
              {profile.name}: {profile.title}
            </h2>

            <p class="character-profile__lead">
              {profile.summary}
            </p>

            {profile.biography.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </article>

          <section
            class="character-profile__chapters"
            aria-labelledby="character-chapters-heading"
          >
            <p class="eyebrow">Connected history</p>

            <h2 id="character-chapters-heading">
              Chapters featuring {profile.name}
            </h2>

            {relatedChapters.length > 0 ? (
              <ol>
                {relatedChapters.map((chapter) => (
                  <li>
                    <a
                      href={withBase(
                        `chapters/${chapter.id}/`
                      )}
                    >
                      <span>
                        Chapter {
                          String(chapter.data.order).padStart(2, '0')
                        }
                      </span>

                      <strong>{chapter.data.title}</strong>
                      <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ol>
            ) : (
              <p>
                This character's main historical chapter
                is being prepared for the archive.
              </p>
            )}
          </section>

          <section class="character-profile__reference">
            <p class="eyebrow">Official reference</p>

            <a
              class="text-link"
              href={profile.source.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {profile.source.title} ↗
            </a>
          </section>
        </div>

        <aside
          class="character-profile__aside"
          aria-label={`Illustrated card: ${profile.featuredCard.name}`}
        >
          <p class="eyebrow">
            Card from the archive
          </p>

          <HistoricalCard card={profile.featuredCard} />
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
