---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PortugueseCatalogControls from '../../../components/PortugueseCatalogControls.astro';
import { withBase } from '../../../utils/paths';
import { portugueseEra } from '../../../utils/pt-catalog.mjs';
import { eras } from '../../../data/eras';
---
<BaseLayout locale="pt-BR" title="Cronologia histórica" description="Explore os dez períodos editoriais da história de Magic: The Gathering.">
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">Enciclopédia do Multiverso · Português brasileiro</p>
      <h1>Cronologia histórica</h1>
      <p>Explore os dez períodos editoriais da história de Magic: The Gathering.</p>
    </div>
  </section>
  <section class="section-spacing">
    <div class="page-shell" data-pt-catalog>
      <a class="text-link" href={withBase('pt-br/')}>← Voltar ao início</a>
      <p><a class="text-link" href={withBase('pt-br/events/')}>Acontecimentos</a> · <a class="text-link" href={withBase('pt-br/timeline/')}>Cronologia</a> · <a class="text-link" href={withBase('pt-br/characters/')}>Personagens</a> · <a class="text-link" href={withBase('pt-br/archive/')}>Arquivo</a></p>
      <p>O catálogo está em português. Os títulos originais, resumos completos e capítulos continuam em inglês.</p>
      <PortugueseCatalogControls id="timeline" count={eras.length} />
      <ol class="character-event-list">
        {eras.map((era) => (
          <li data-pt-entry data-pt-search={`${era.name} ${era.kicker} ${portugueseEra(era.id).name} ${portugueseEra(era.id).summary}`}>
            <a href={withBase(`chapters/${era.id}/`)} hreflang="en">
              <span>Capítulo {era.chapter} · {era.kicker} (EN)</span>
              <strong>{portugueseEra(era.id).name}</strong>
              <span>{portugueseEra(era.id).summary}</span>
              <span>Título original: {era.name}</span>
              <span>Ler o capítulo em inglês →</span>
            </a>
            {era.id === 'thran' && (
              <p><a class="text-link" href={withBase('pt-br/chapters/thran/')} lang="pt-BR">Ler a versão condensada em português →</a></p>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
<script>
  import { setupPortugueseCatalog } from '../../../utils/pt-catalog.mjs';
  setupPortugueseCatalog();
</script>
