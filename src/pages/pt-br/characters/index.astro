---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PortugueseCatalogControls from '../../../components/PortugueseCatalogControls.astro';
import CharacterPortrait from '../../../components/CharacterPortrait.astro';
import { withBase } from '../../../utils/paths';
import { characters } from '../../../data/characters';
const people = [...characters].sort((a, b) => a.name.localeCompare(b.name));
---
<BaseLayout locale="pt-BR" title="Personagens históricos" description="Encontre as figuras que moldaram o Multiverso.">
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">Enciclopédia do Multiverso · Português brasileiro</p>
      <h1>Personagens históricos</h1>
      <p>Encontre as figuras que moldaram o Multiverso.</p>
    </div>
  </section>
  <section class="section-spacing">
    <div class="page-shell" data-pt-catalog>
      <a class="text-link" href={withBase('pt-br/')}>← Voltar ao início</a>
      <p><a class="text-link" href={withBase('pt-br/events/')}>Acontecimentos</a> · <a class="text-link" href={withBase('pt-br/timeline/')}>Cronologia</a> · <a class="text-link" href={withBase('pt-br/characters/')}>Personagens</a> · <a class="text-link" href={withBase('pt-br/archive/')}>Arquivo</a></p>
      <p>Os nomes dos personagens são mantidos; perfis, biografias e descrições estão em inglês.</p>
      <p>{people.length} personagens documentados.</p>
      <PortugueseCatalogControls id="characters" count={people.length} />
      <ol class="character-event-list character-pt-grid">
        {people.map((person) => (
          <li data-pt-entry data-pt-search={`${person.name} ${person.title} ${person.origin} ${person.role}`}>
            <a class="character-pt-entry" href={withBase(`characters/${person.id}/`)} hreflang="en">
              <CharacterPortrait printingId={person.featuredCardId} characterName={person.name}
                significance={person.featuredCard.significance} locale="pt-BR" />
              <span class="character-pt-entry__copy">
                <strong>{person.name}</strong>
                <span>{person.origin} · {person.role}</span>
                <span>Abrir perfil em inglês →</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
<script>
  import { setupPortugueseCatalog } from '../../../utils/pt-catalog.mjs';
  setupPortugueseCatalog();
</script>
