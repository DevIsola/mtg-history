---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import HomepageArtwork from '../../components/HomepageArtwork.astro';
import HomeEraStrip from '../../components/HomeEraStrip.astro';
import { eras } from '../../data/eras';
import { localPath, phrase } from '../../utils/locale';
const locale = 'pt-BR' as const;
const t = (english: string) => phrase(locale, english);

const highlighted = eras.slice(0, 4).map(era => ({ ...era, name: t(era.name), kicker: t(era.kicker), summary: t(era.summary) }));
const counts = {
  chapters: (await getCollection('chapters')).length,
  events: (await getCollection('events')).length,
  characters: (await getCollection('characters')).length,
  relationships: (await getCollection('relationships')).length,
};
---
<BaseLayout locale={locale}
  title={t("A history written across worlds")}
  description={t("Travel through the history of Magic: The Gathering. Explore its events, major expansions, and the cards that preserve their stories.")}
>
  <section class="hero homepage-hero">
    <div class="page-shell hero__content homepage-hero__grid">
      <div class="homepage-hero__copy">
        <p class="eyebrow eyebrow--light">{t("An independent illustrated history of Magic: The Gathering")}</p>
        <h1>{t("Every world")}<br />{t("has a history.")}</h1>
        <p class="hero__lead">{t("Follow the wars, discoveries, and people that shaped the Multiverse. Read in story order, then explore the actual cards and publications that preserve its history.")}</p>
        <div class="hero__actions">
          <a class="button button--gold" href={localPath('chapters/thran/', locale)}>{t("Start reading")} <span aria-hidden="true">→</span></a>
          <a class="button button--outline" href={localPath('timeline/', locale)}>{t("Explore the timeline")}</a>
        </div>
        <p class="hero__aside">{t("Story chronology is distinct from publication history.")}</p>
      </div>

    </div>
  </section>

  <section class="homepage-numbers" aria-label={t("Documented archive coverage")}>
    <dl class="page-shell">
      <div><dt>{t("Chapters")}</dt><dd>{counts.chapters}</dd></div>
      <div><dt>{t("Historical events")}</dt><dd>{counts.events}</dd></div>
      <div><dt>{t("Characters")}</dt><dd>{counts.characters}</dd></div>
      <div><dt>{t("Documented ties")}</dt><dd>{counts.relationships}</dd></div>
    </dl>
  </section>

  <HomeEraStrip locale={locale} />

<section
  class="journey-section section-spacing"
  aria-labelledby="journey-heading"
>
  <div class="page-shell">
    <div class="journey-intro">
      <p class="eyebrow">{t("Choose your path")}</p>

      <h2 id="journey-heading" class="section-title">
        {t("Ways to explore")}
        <em> {t("the Multiverse.")}</em>
      </h2>

      <p>
        {t("Follow the events that shaped history, meet those who lived through them, or examine the cards that preserve their stories.")}
      </p>
    </div>

    <div class="journey-grid homepage-journey-grid">
      <a class="journey-card" href={localPath('timeline/', locale)}>
        <span class="journey-card__number">{t("01 / HISTORY")}</span>
        <span class="journey-card__symbol" aria-hidden="true">✧</span>

        <h3>{t("Follow the story")}</h3>

        <p>
          {t("Travel through major historical eras, from the fall of the Thran to the Mending and beyond.")}
        </p>

        <span class="journey-card__action">
          {t("Explore the timeline →")}
        </span>
      </a>

      <a class="journey-card" href={localPath('characters/', locale)}>
        <span class="journey-card__number">{t("02 / PEOPLE")}</span>
        <span class="journey-card__symbol" aria-hidden="true">✧</span>

        <h3>{t("Meet the legends")}</h3>

        <p>
          {t("Discover the figures behind the great conflicts, their transformations, and their connections across chapters.")}
        </p>

        <span class="journey-card__action">
          {t("Browse characters →")}
        </span>
      </a>

      <a class="journey-card" href={localPath('archive/', locale)}>
        <span class="journey-card__number">{t("03 / ARTIFACTS")}</span>
        <span class="journey-card__symbol" aria-hidden="true">✧</span>

        <h3>{t("Explore the archive")}</h3>

        <p>
          {t("Browse illustrated Magic cards as historical records of the people, events, and places they depict.")}
        </p>

        <span class="journey-card__action">
          {t("Open the archive →")}
        </span>
      </a>
      <a class="journey-card" href={localPath('relationships/', locale)}>
        <span class="journey-card__number">{t("04 / CONNECTIONS")}</span>
        <span class="journey-card__symbol" aria-hidden="true">✧</span>
        <h3>{t("Trace relationships")}</h3>
        <p>{t("Examine documented alliances, rivalries, family ties and mentorships without conflating shared chapters with proven connections.")}</p>
        <span class="journey-card__action">{t("Open the relationship atlas →")}</span>
      </a>
    </div>

    <p class="journey-discover-link">
      <a
        class="text-link"
        href={localPath('discover/', locale)}
      >
        {t("Or search the entire encyclopedia →")}
      </a>
    </p>

  </div>
</section>

  <section class="eras-section section-spacing" aria-labelledby="eras-heading">
    <div class="page-shell">
      <div class="section-topline">
        <div>
          <p class="eyebrow">{t("Begin the journey")}</p>
          <h2 id="eras-heading" class="section-title">{t("The first")} <em>{t("chapters")}</em></h2>
        </div>
        <a class="text-link" href={localPath('timeline/', locale)}>{t("View complete timeline")} <span aria-hidden="true">→</span></a>
      </div>
      <div class="era-card-grid homepage-era-grid">
        {highlighted.map((era) => (
          <article class="era-card homepage-era-card">
            <HomepageArtwork locale={locale} chapterId={era.id} variant="tile" />
            <div class="homepage-era-card__text">
              <span class="era-card__kicker">{t('Chapter')} {era.chapter} · {era.kicker}</span>
              <h3>{era.name}</h3>
              <p>{era.summary}</p>
              <a class="homepage-era-card__read" href={localPath(`chapters/${era.id}/`, locale)}>{t("Read historical chapter →")}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="intro-section section-spacing" aria-labelledby="intro-heading">
    <div class="page-shell intro-grid">
      <div class="intro-heading">
        <p class="eyebrow">{t("The archive")}</p>
        <h2 id="intro-heading" class="section-title">{t("Not simply a list")}<br />{t("of")} <em>{t("expansions.")}</em></h2>
      </div>
      <div class="intro-copy">
      <HomepageArtwork locale={locale} chapterId="war-of-the-spark" variant="editorial" />

        <p class="lead-copy">{t("This is a history of the Multiverse told through its defining moments.")}</p>
        <p>{t("Each chapter connects the events of Magic's story to the sets that revealed them—and to selected cards whose art and flavor text bring those moments to life.")}</p>
        <p>{t("Follow the story in narrative order, then discover when each piece of that history appeared in the real world.")}</p>
        <a class="text-link" href={localPath('about/', locale)}>{t("How the archive is organized")} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>









  <section class="editorial-section section-spacing" aria-labelledby="editorial-heading">
    <div class="page-shell editorial-grid">
      <HomepageArtwork locale={locale} chapterId="omenpaths" variant="editorial" />
      <div>
        <p class="eyebrow">{t("An illustrated chronicle")}</p>
        <h2 id="editorial-heading" class="section-title">{t("Cards as")} <em>{t("historical artifacts.")}</em></h2>
        <p>{t("We'll feature a small selection of cards in each chapter, chosen because they depict a scene, identify an important figure, or preserve a piece of the narrative in their flavor text.")}</p>
        <p class="muted-copy">{t("The archive now connects historical chapters, illustrated card references, and character profiles across the history of the Multiverse.")}</p>
      </div>
    </div>
  </section>
</BaseLayout>
