---
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HistoricalCard from '../../../components/HistoricalCard.astro';
import IssueReporter from '../../../components/IssueReporter.astro';
import { historicalEvents } from '../../../data/events';
import { withBase } from '../../../utils/paths';
import { PORTUGUESE_BATCH_1 } from '../../../data/pt-chapter-batch1.mjs';
import { PORTUGUESE_BATCH_2 } from '../../../data/pt-chapter-batch2.mjs';
import { PORTUGUESE_BATCH_3 } from '../../../data/pt-chapter-batch3.mjs';
import type { PortugueseChapter } from '../../../data/pt-chapter-batch1.mjs';

export function getStaticPaths() {
  return [...PORTUGUESE_BATCH_1, ...PORTUGUESE_BATCH_2, ...PORTUGUESE_BATCH_3].map((companion) => ({
    params: { id: companion.id },
    props: { companion },
  }));
}

const { companion } = Astro.props as { companion: PortugueseChapter };
const chapter = await getEntry('chapters', companion.id);
if (!chapter) throw new Error(`Missing canonical chapter ${companion.id}`);
if (chapter.data.cardIds.length !== chapter.data.cards.length) {
  throw new Error(`Printing/significance count mismatch: ${companion.id}`);
}
const eventLookup = new Map(historicalEvents.map(event => [event.id, event]));
const events = companion.eventIds.map(id => {
  const event = eventLookup.get(id);
  if (!event || event.chapterId !== companion.id) {
    throw new Error(`Incorrect Portuguese companion event ${companion.id}: ${id}`);
  }
  return event;
});
const cardReferences = chapter.data.cardIds.map((reference, index) => ({
  scryfallId: typeof reference === 'string' ? reference : reference.id,
  significance: chapter.data.cards[index].significance,
}));
---
<BaseLayout locale="pt-BR" title={`${companion.title} — leitura em português`} description={companion.subtitle} printingId={chapter.data.cardIds[0].id}>
  <div class="chapter-theme" data-era-theme={companion.id} data-pt-chapter-batch>
    <section class="page-banner">
      <div class="page-shell">
        <p class="eyebrow eyebrow--light">Capítulo histórico {companion.number} · Leitura em português brasileiro</p>
        <h1>{companion.title}</h1>
        <p>{companion.subtitle}</p>
        <a class="chapter-banner__start" href="#leitura">Começar a leitura ↓</a>
      </div>
    </section>

    <section class="chapter-reader" id="leitura" aria-label="Narrativa histórica em português">
      <div class="page-shell pt-batch-reading">
        <p><a class="text-link" href={withBase('pt-br/timeline/')}>← Voltar à cronologia em português</a></p>
        <div class="pt-batch-notice" role="note">
          <strong>Adaptação editorial em português; não é uma tradução integral.</strong>
          Esta edição apresenta as principais histórias em português, mas ainda requer revisão detalhada
          de equivalência textual. Os nomes originais das cartas, os registros de acontecimentos e
          as legendas canônicas das ilustrações permanecem em inglês.
          <a href={withBase(`chapters/${companion.id}/`)} hreflang="en">Leia o capítulo completo em inglês (EN)</a>.
        </div>

        {companion.id === 'march-of-the-machine' && (
          <nav aria-label="Seções movidas para A ascensão de Nova Phyrexia">
            <p>Os preparativos da invasão agora estão em A ascensão de Nova Phyrexia:</p>
            <ul>
              {PORTUGUESE_BATCH_3.find(entry => entry.id === 'new-phyrexia')!.sections.slice(0, 4).map(section => (
                <li id={section.id}><a href={withBase(`pt-br/chapters/new-phyrexia/#${section.id}`)}>{section.title}</a></li>
              ))}
            </ul>
          </nav>
        )}

        <nav class="pt-batch-toc" aria-label="Índice da leitura">
          <h2>Índice</h2>
          <ol>
            {companion.sections.map((section, index) => (
              <li><a href={`#${section.id}`}>{String(index + 1).padStart(2, '0')}. {section.title}</a></li>
            ))}
          </ol>
        </nav>

        <article class="chapter-prose pt-batch-narrative" data-pt-batch-narrative>
          {companion.sections.map((section, index) => (
            <section id={section.id} data-pt-batch-section>
              <h2>{String(index + 1).padStart(2, '0')}. {section.title}</h2>
              {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
            </section>
          ))}
        </article>

        <section class="pt-batch-resources" aria-labelledby="pt-batch-events-heading">
          <h2 id="pt-batch-events-heading">Acontecimentos relacionados</h2>
          <p>Os registros detalhados abaixo estão em inglês (EN); sua identidade histórica é compartilhada com o capítulo original.</p>
          <ol data-pt-batch-events>
            {events.map(event => (
              <li><a href={withBase(`events/${event.id}/`)} hreflang="en">{event.title} (EN) ↗</a></li>
            ))}
          </ol>
        </section>

        <section class="pt-batch-resources" aria-labelledby="pt-batch-artwork-heading">
          <h2 id="pt-batch-artwork-heading">Cartas e ilustrações do capítulo</h2>
          <p>Exatamente as mesmas impressões selecionadas no capítulo inglês. As legendas editoriais abaixo estão no idioma original e não são apresentadas como traduções.</p>
          <div class="pt-batch-cards" data-pt-batch-cards>
            {cardReferences.map(card => <HistoricalCard card={card} />)}
          </div>
        </section>

        <section class="pt-batch-resources" aria-labelledby="pt-batch-sources-heading">
          <h2 id="pt-batch-sources-heading">Fontes e leitura complementar</h2>
          <p>A bibliografia é obtida diretamente do capítulo publicado em inglês. Os títulos e links originais foram preservados.</p>
          <ol data-pt-batch-sources>
            {chapter.data.sources.map(source => (
              <li>
                {source.url
                  ? <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>
                  : <cite>{source.title}</cite>}
                {source.author && <span> · {source.author}</span>}
                {source.year && <span> · {source.year}</span>}
              </li>
            ))}
          </ol>
          <p><a class="text-link" href={withBase(`chapters/${companion.id}/`)} hreflang="en">Ler a versão integral em inglês (EN) →</a></p>
          <p><a class="text-link" href={withBase('pt-br/timeline/')}>← Voltar à cronologia em português</a></p>
        </section>
        <IssueReporter chapterId={companion.id} chapterTitle={companion.title} />
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .pt-batch-reading { max-width: 1020px; margin-inline: auto; padding-block: 2.5rem 5rem; }
  .pt-batch-notice { padding: 1.25rem 1.5rem; background: var(--paper-deep); color: var(--ink); border-inline-start: 4px solid var(--gold); margin-block: 1.75rem 2rem; line-height: 1.8; }
  .pt-batch-notice strong { display: block; }
  .pt-batch-notice a { color: var(--link-color); text-decoration: underline; }
  .pt-batch-toc { border: 1px solid var(--line); background: var(--paper-white); padding: 1.5rem; margin-bottom: 3rem; }
  .pt-batch-toc h2 { margin-bottom: 1rem; }
  .pt-batch-toc ol { columns: 2; column-gap: 2rem; padding-left: 1.5rem; }
  .pt-batch-toc li { break-inside: avoid; margin-bottom: 0.5rem; }
  .pt-batch-toc a, .pt-batch-resources a { color: var(--link-color); text-underline-offset: 0.2em; overflow-wrap: anywhere; }
  .pt-batch-narrative > section { margin-bottom: 2.75rem; }
  .pt-batch-resources { border-top: 1px solid var(--line); margin-top: 3rem; padding-top: 2.5rem; line-height: 1.8; }
  .pt-batch-resources ol { padding-inline-start: 1.5rem; }
  .pt-batch-resources li { margin-block: 0.45rem; }
  .pt-batch-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 2rem; align-items: start; margin-top: 2rem; }
  @media (max-width: 680px) { .pt-batch-reading { padding-block: 1.5rem 3rem; } .pt-batch-toc ol { columns: 1; } }
</style>
