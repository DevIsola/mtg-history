---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PortugueseCatalogControls from '../../../components/PortugueseCatalogControls.astro';
import { withBase } from '../../../utils/paths';
import { portugueseEra } from '../../../utils/pt-catalog.mjs';
import { eras } from '../../../data/eras';
import { historicalEvents } from '../../../data/events';
const sections = eras.map((era) => ({ era, events: historicalEvents.filter((event) => event.chapterId === era.id) })).filter((item) => item.events.length > 0);
---
<BaseLayout locale="pt-BR" title="Acontecimentos históricos" description="Conheça os acontecimentos registrados nos dez capítulos.">
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">Enciclopédia do Multiverso · Português brasileiro</p>
      <h1>Acontecimentos históricos</h1>
      <p>Conheça os acontecimentos registrados nos dez capítulos.</p>
    </div>
  </section>
  <section class="section-spacing">
    <div class="page-shell" data-pt-catalog>
      <a class="text-link" href={withBase('pt-br/')}>← Voltar ao início</a>
      <p><a class="text-link" href={withBase('pt-br/events/')}>Acontecimentos</a> · <a class="text-link" href={withBase('pt-br/timeline/')}>Cronologia</a> · <a class="text-link" href={withBase('pt-br/characters/')}>Personagens</a> · <a class="text-link" href={withBase('pt-br/archive/')}>Arquivo</a></p>
      <p>As descrições e os nomes originais dos acontecimentos ainda estão em inglês. Nenhuma narrativa foi traduzida nesta etapa.</p>
      <p>{historicalEvents.length} acontecimentos documentados.</p>
      <PortugueseCatalogControls id="events" count={historicalEvents.length} />
      {sections.map(({ era, events }) => (
        <section data-pt-group aria-label={portugueseEra(era.id).name}>
          <h2 class="section-title">{portugueseEra(era.id).name}</h2>
          <p>{portugueseEra(era.id).summary}</p>
          <ol class="character-event-list">
            {events.map((event) => (
              <li data-pt-entry data-pt-search={`${event.title} ${event.summary} ${era.name} ${portugueseEra(era.id).name}`}><a href={withBase(`events/${event.id}/`)} hreflang="en">
                <strong>{event.title}</strong>
                <span>Ler relato em inglês →</span>
              </a></li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
<script>
  import { setupPortugueseCatalog } from '../../../utils/pt-catalog.mjs';
  setupPortugueseCatalog();
</script>
