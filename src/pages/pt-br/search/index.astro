---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../utils/paths';
---

<BaseLayout
  locale="pt-BR"
  title="Pesquisar o Multiverso"
  description="Busque nos capítulos históricos adaptados e nos catálogos disponíveis em português brasileiro."
>
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">Enciclopédia do Multiverso</p>
      <h1>Pesquise a <em>história.</em></h1>
      <p>Encontre acontecimentos, personagens e capítulos nas leituras adaptadas em português.</p>
    </div>
  </section>

  <section class="section-spacing" data-pagefind-ignore
    data-fulltext-search
    data-fulltext-locale="pt-BR"
    data-pagefind-bundle={withBase('pagefind/pagefind.js')}
    data-pagefind-base={withBase('')}
  >
    <div class="page-shell fulltext-search">
      <div class="fulltext-search__panel">
        <label for="fulltext-query">Pesquisar o conteúdo em português</label>
        <input id="fulltext-query" type="search" autocomplete="off"
          placeholder="Centelha, reparação, Phyrexia…" maxlength="160"
          aria-controls="fulltext-results" />
        <p class="fulltext-search__status" data-fulltext-status role="status"
          aria-live="polite" aria-atomic="true">Digite um termo para pesquisar a história.</p>
      </div>
      <ol class="fulltext-search__results" id="fulltext-results" data-fulltext-results></ol>
      <p class="fulltext-search__notice">
        Prefere explorar por personagem ou período histórico?
        <a href={withBase('pt-br/timeline/')}>Explore a cronologia em português</a>.
      </p>
      <noscript><p class="fulltext-search__notice">A busca textual exige JavaScript.
        <a href={withBase('pt-br/timeline/')}>A cronologia em português</a> funciona sem ele.</p></noscript>
    </div>
  </section>
</BaseLayout>

<script>
  import { normalizeFullTextQuery, plainExcerpt, safeSearchResultUrl, PAGEFIND_RESULT_LIMIT } from '../../../utils/pagefind-search.mjs';

  const root = document.querySelector<HTMLElement>('[data-fulltext-search]');
  const input = root?.querySelector<HTMLInputElement>('#fulltext-query');
  const status = root?.querySelector<HTMLElement>('[data-fulltext-status]');
  const results = root?.querySelector<HTMLOListElement>('[data-fulltext-results]');

  if (root && input && status && results) {
    const base = root.dataset.pagefindBase ?? '/';
    const bundle = root.dataset.pagefindBundle ?? '';
    let apiPromise: Promise<any> | undefined;
    let lastRequest = 0;
    let debounce: ReturnType<typeof setTimeout> | undefined;

    const pagefind = () => {
      if (!apiPromise) {
        apiPromise = import(/* @vite-ignore */ bundle).then(async (module) => {
          await module.options({ baseUrl: base });
          return module;
        });
      }
      return apiPromise;
    };

    const clearResults = () => { results.replaceChildren(); };
    const setStatus = (message: string) => { status.textContent = message; };

    const search = async (term: string, sequence: number) => {
      try {
        const index = await pagefind();
        const matches = await index.search(term);
        const items = await Promise.all(matches.results.slice(0, PAGEFIND_RESULT_LIMIT).map(
          (result: { data: () => Promise<any> }) => result.data(),
        ));
        if (sequence !== lastRequest) return;
        clearResults();
        let rendered = 0;
        for (const item of items) {
          const url = safeSearchResultUrl(item.url, base, window.location.origin);
          if (!url || !url.startsWith(`${base}pt-br/`)) continue;
          const li = document.createElement('li');
          const a = document.createElement('a');
          const title = document.createElement('strong');
          const excerpt = document.createElement('span');
          a.href = url;
          title.textContent = String(item.meta?.title ?? item.url ?? 'Registro histórico');
          excerpt.textContent = plainExcerpt(item.excerpt);
          a.append(title, excerpt);
          li.append(a);
          results.append(li);
          rendered++;
        }
        const total = Number(matches.results.length) || 0;
        setStatus(total === 0 ? 'Nenhum registro encontrado em português.' :
          `Exibindo ${rendered} de ${total} registros encontrados.`);
      } catch {
        if (sequence !== lastRequest) return;
        clearResults();
        setStatus('Índice indisponível. Execute a compilação e abra a prévia de produção para pesquisar.');
      } finally {
        if (sequence === lastRequest) results.removeAttribute('aria-busy');
      }
    };

    input.addEventListener('input', () => {
      if (debounce) clearTimeout(debounce);
      const sequence = ++lastRequest;
      const term = normalizeFullTextQuery(input.value);
      if (term.length < 2) {
        clearResults();
        results.removeAttribute('aria-busy');
        setStatus(term ? 'Digite pelo menos dois caracteres.' : 'Digite um termo para pesquisar a história.');
        return;
      }
      results.setAttribute('aria-busy', 'true');
      setStatus('Pesquisando registros históricos…');
      debounce = setTimeout(() => { void search(term, sequence); }, 220);
    });
  }
</script>
