---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterChronology from '../components/ChapterChronology.astro';
import TimelineArtwork from '../components/TimelineArtwork.astro';
import { eras } from '../data/eras';
import { historicalEvents } from '../data/events';
import { characters } from '../data/characters';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/paths';

const chapters = (await getCollection('chapters'))
  .sort((a, b) => a.data.order - b.data.order);
const byEra = new Map(chapters.map((chapter) => [chapter.data.eraId, chapter]));
const characterNames = new Map(characters.map((person) => [person.id, person.name]));

const entries = eras.map((era) => {
  const chapter = byEra.get(era.id);
  const events = historicalEvents.filter((event) => event.chapterId === era.id);
  const people = new Set(events.flatMap((event) => event.characterIds));
  const eraSearch = [
    era.name, era.kicker, era.summary, ...era.sets,
    chapter?.data.chronology.storyPeriod ?? '',
    chapter?.data.chronology.storyDetail ?? '',
    chapter?.data.chronology.publicationHistory ?? '',
  ].join(' ');
  const eventRecords = events.map((event) => ({
    event,
    search: [event.title, event.summary,
      ...event.characterIds.map((id) => characterNames.get(id) ?? ''),
    ].join(' '),
  }));
  const searchText = [eraSearch, ...eventRecords.map(({ search }) => search),
    ...[...people].map((id) => characterNames.get(id) ?? ''),
  ].join(' ');
  return { era, chapter, eventRecords, eraSearch, searchText };
});
---
<BaseLayout
  title="Historical timeline explorer"
  description="Explore the historical eras, defining events, characters, and chapter chronology of the Magic Multiverse."
>
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">An interactive historical atlas</p>
      <h1>Explore the <em>timeline.</em></h1>
      <p>Move from an era to its defining events, characters, and published narrative. This is an editorial reading order, not a scale drawing of in-universe time.</p>
    </div>
  </section>

  <section class="atlas-section section-spacing" data-timeline-explorer>
    <div class="page-shell">
      <div class="atlas-intro">
        <div>
          <p class="eyebrow">The story at a glance</p>
          <h2 class="section-title">History has <em>many layers.</em></h2>
          <p>Browse the key developments within each period, then open the original chapter or a specific historical event.</p>
        </div>
        <div class="atlas-stats" aria-label="Archive coverage">
          <div><strong>{eras.length}</strong><span>historical eras</span></div>
          <div><strong>{chapters.length}</strong><span>published chapters</span></div>
          <div><strong>{historicalEvents.length}</strong><span>documented events</span></div>
        </div>
      </div>

      <div class="atlas-tools" id="timeline-controls" hidden>
        <div class="atlas-tools__field atlas-tools__field--search">
          <label for="timeline-search">Search history</label>
          <input id="timeline-search" type="search" placeholder="A person, place, event, or card set..." autocomplete="off" />
        </div>
        <div class="atlas-tools__field">
          <label for="timeline-era">Filter by historical era</label>
          <select id="timeline-era">
            <option value="">All historical eras</option>
            {eras.map((era) => <option value={era.id}>{era.chapter} · {era.name}</option>)}
          </select>
        </div>
        <div class="atlas-tools__actions">
          <button type="button" id="timeline-expand" aria-pressed="false">Expand all event lists</button>
          <button type="button" id="timeline-reset" disabled>Clear filters</button>
        </div>
        <p id="timeline-status" class="atlas-tools__status" role="status" aria-live="polite" aria-atomic="true">Showing {eras.length} eras</p>
      </div>

      <nav class="atlas-jumps" id="timeline-jumps" aria-label="Jump to a historical era">
        {eras.map((era) => <a href={'#' + era.id}><span>{era.chapter}</span> {era.name}</a>)}
      </nav>

      <p class="atlas-empty" id="timeline-empty" hidden>No eras match those terms. Try a different search or clear the filters.</p>

      <div class="atlas-track atlas-track--editorial">
        {entries.map(({ era, chapter, eventRecords, eraSearch, searchText }) => (
          <article class="atlas-era" id={era.id} data-timeline-era data-id={era.id} data-search={searchText} data-era-search={eraSearch}>
            <div class="atlas-era__rail" aria-hidden="true"><span>{era.chapter}</span></div>
            <div class="atlas-era__content">
              <div class="atlas-era__topline">
                <span>{era.kicker}</span>
                <span>{chapter ? 'Chapter available' : era.status === 'in-progress' ? 'In progress' : 'Planned'}</span>
              </div>
              <h3>{era.name}</h3>
              <p class="atlas-era__summary">{era.summary}</p>
              {chapter && (
                <div class="atlas-era__chronology">
                  <div><span>Story period</span><strong>{chapter.data.chronology.storyPeriod}</strong></div>
                  <div><span>In publication</span><strong>{chapter.data.chronology.publicationHistory}</strong></div>
                </div>
              )}
              <div class="atlas-era__links">
                {chapter && <a class="atlas-primary-link" href={withBase('chapters/' + chapter.id + '/#chapter-reader')}>Read the chapter →</a>}
                <a class="text-link" href={withBase('events/') + '#' + era.id}>Browse events in context →</a>
              </div>
              {chapter && <TimelineArtwork chapter={chapter} />}
              {eventRecords.length > 0 && (
                <details class="atlas-era__events" data-timeline-details>
                  <summary><span>Defining historical events</span><small data-timeline-event-count>{eventRecords.length} records</small></summary>
                  <ol>
                    {eventRecords.map(({ event, search }) => (
                      <li data-timeline-event data-search={search}>
                        <a href={withBase('events/' + event.id + '/')}>
                          <strong>{event.title}</strong>
                          <span>{event.summary}</span>
                          <span class="atlas-event-action">Read event →</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </details>
              )}
              <div class="atlas-era__publications">
                <strong>Related publications</strong>
                <ul>{era.sets.map((set) => <li>{set}</li>)}</ul>
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="atlas-note">Story-period dates and publication dates describe different timelines. Events within a chapter may overlap with other stories; labels and event groupings are editorial guides, not a claim of exact cross-planar dating.</p>
      <a class="text-link" href={withBase('relationships/')}>Explore the people connected by these events →</a>
    </div>
  </section>
  <div class="chronology-band"><div class="page-shell"><ChapterChronology chapters={chapters} /></div></div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-timeline-explorer]');
  if (root) {
    const controls = root.querySelector<HTMLElement>('#timeline-controls');
    const search = root.querySelector<HTMLInputElement>('#timeline-search');
    const eraSelect = root.querySelector<HTMLSelectElement>('#timeline-era');
    const reset = root.querySelector<HTMLButtonElement>('#timeline-reset');
    const expand = root.querySelector<HTMLButtonElement>('#timeline-expand');
    const status = root.querySelector<HTMLElement>('#timeline-status');
    const empty = root.querySelector<HTMLElement>('#timeline-empty');
    const jumps = root.querySelector<HTMLElement>('#timeline-jumps');
    const records = Array.from(root.querySelectorAll<HTMLElement>('[data-timeline-era]'));
    const details = Array.from(root.querySelectorAll<HTMLDetailsElement>('[data-timeline-details]'));
    const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();

    if (controls && search && eraSelect && reset && expand && status && empty && jumps) {
      const indexed = records.map((element) => ({
        element,
        text: normalize(element.dataset.search ?? ''),
        eraText: normalize(element.dataset.eraSearch ?? ''),
        details: element.querySelector<HTMLDetailsElement>('[data-timeline-details]'),
        events: Array.from(element.querySelectorAll<HTMLElement>('[data-timeline-event]'))
          .map((row) => ({ row, text: normalize(row.dataset.search ?? '') })),
      }));

      const syncExpand = () => {
        const visible = details.filter((detail) => !detail.closest<HTMLElement>('[data-timeline-era]')?.hidden);
        const allOpen = visible.length > 0 && visible.every((detail) => detail.open);
        expand.setAttribute('aria-pressed', String(allOpen));
        expand.textContent = allOpen ? 'Collapse all event lists' : 'Expand all event lists';
      };

      const update = () => {
        const words = normalize(search.value).split(/\s+/).filter(Boolean);
        const selected = eraSelect.value;
        let count = 0;
        for (const record of indexed) {
          const match = (!selected || record.element.dataset.id === selected)
            && words.every((word) => record.text.includes(word));
          record.element.hidden = !match;
          if (!match) continue;
          count++;

          // When an event matches but the era itself does not, surface the
          // matching records rather than opening a lengthy unfiltered list.
          const eraMatches = words.every((word) => record.eraText.includes(word));
          const matchingEvents = record.events.filter(({ text }) =>
            words.every((word) => text.includes(word)));
          const narrowEvents = words.length > 0 && !eraMatches && matchingEvents.length > 0;
          for (const { row } of record.events) {
            row.hidden = narrowEvents && !matchingEvents.some((match) => match.row === row);
          }
          const countLabel = record.details?.querySelector<HTMLElement>('[data-timeline-event-count]');
          if (countLabel) {
            countLabel.textContent = narrowEvents
              ? matchingEvents.length + ' matching records'
              : record.events.length + ' records';
          }
          if (narrowEvents && record.details) record.details.open = true;
        }
        status.textContent = 'Showing ' + count + ' of ' + records.length + ' historical eras';
        empty.hidden = count > 0;
        jumps.hidden = Boolean(selected || words.length);
        reset.disabled = !(selected || words.length);
        syncExpand();
      };
      search.addEventListener('input', update);
      eraSelect.addEventListener('change', update);
      reset.addEventListener('click', () => {
        search.value = '';
        eraSelect.value = '';
        update();
        search.focus();
      });
      for (const detail of details) detail.addEventListener('toggle', syncExpand);
      expand.addEventListener('click', () => {
        const open = expand.getAttribute('aria-pressed') !== 'true';
        for (const detail of details) {
          if (!detail.closest<HTMLElement>('[data-timeline-era]')?.hidden) detail.open = open;
        }
        syncExpand();
      });
      controls.hidden = false;
      update();
    }
  }
</script>
