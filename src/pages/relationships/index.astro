---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { characters } from '../../data/characters';
import { characterRelationships } from '../../data/relationships';
import { getCollection } from 'astro:content';
import { withBase } from '../../utils/paths';

const byId = new Map(characters.map((person) => [person.id, person]));
const chapters = await getCollection('chapters');
const chapterNames = new Map(chapters.map((chapter) => [chapter.id, chapter.data.title]));
const connectedIds = new Set(characterRelationships.flatMap((relation) => [relation.a, relation.b]));
const people = [...characters].filter((person) => connectedIds.has(person.id))
  .sort((a, b) => a.name.localeCompare(b.name));
const initialId = people.find((person) => person.id === 'urza')?.id ?? people[0]?.id ?? '';
const categoryLabels = {
  family: 'Family', friendship: 'Friendship', alliance: 'Alliance',
  rivalry: 'Conflict', mentorship: 'Mentorship', creation: 'Creation',
};
---
<BaseLayout
  title="Character relationship explorer"
  description="Trace the documented family ties, mentorships, alliances, and conflicts connecting historical figures in Magic's Multiverse."
>
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">The people behind the history</p>
      <h1>Connections across the <em>Multiverse.</em></h1>
      <p>Explore documented character connections in an interactive graph or follow individual relationships through the historical record.</p>
    </div>
  </section>

  <section class="network-section section-spacing" data-relationship-explorer>
    <div class="page-shell">
      <div class="network-intro">
        <div>
          <p class="eyebrow">Relationship atlas</p>
          <h2 class="section-title">History is shaped by <em>people.</em></h2>
          <p>Connections are curated from the existing historical record. Categories summarize each relationship; the descriptions and chapter links provide context.</p>
        </div>
        <div class="network-metrics" aria-label="Relationship coverage">
          <div><strong>{people.length}</strong><span>connected figures</span></div>
          <div><strong>{characterRelationships.length}</strong><span>documented ties</span></div>
        </div>
      </div>

      <div class="network-tools" id="network-controls" hidden>
        <div class="network-field">
          <label for="network-person">Focus on a character</label>
          <select id="network-person">
            {people.map((person) => <option value={person.id} selected={person.id === initialId}>{person.name}</option>)}
          </select>
        </div>
        <div class="network-field">
          <label for="network-category">Relationship type</label>
          <select id="network-category">
            <option value="">All relationships</option>
            {Object.entries(categoryLabels).map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </div>
        <button type="button" id="network-reset">Reset view</button>
      </div>

      <div class="network-view-switch" id="network-view-switch" hidden aria-label="Relationship display mode">
        <span class="network-view-switch__label">Explore relationships</span>
        <button type="button" id="network-show-graph" aria-pressed="true">Graph view</button>
        <button type="button" id="network-show-cards" aria-pressed="false">Relationship cards</button>
      </div>

      <div class="network-focus" id="network-focus" hidden>
        <span class="eyebrow">Current focus</span>
        <strong id="network-focus-name">{byId.get(initialId)?.name ?? ''}</strong>
        <p id="network-count" role="status" aria-live="polite" aria-atomic="true"></p>
        <a id="network-profile" href={withBase('characters/' + initialId + '/')}>Open character biography →</a>
      </div>

      <p class="network-empty" id="network-empty" hidden>No documented connections match this category for the selected character. Choose another relationship type or a different figure.</p>

      <section class="network-visual" id="network-visual" aria-labelledby="network-visual-heading" hidden>
        <div class="network-visual__toolbar">
          <div>
            <h3 id="network-visual-heading">Character connections</h3>
            <p>Drag to explore, scroll or pinch to zoom, and select a node to focus on a character. For keyboard navigation and historical context, use the character selector or relationship cards.</p>
          </div>
          <div class="network-visual__actions" aria-label="Graph zoom controls">
            <button type="button" id="network-zoom-out" aria-label="Zoom out of relationship graph">−</button>
            <button type="button" id="network-zoom-in" aria-label="Zoom into relationship graph">+</button>
            <button type="button" id="network-fit">Fit graph</button>
          </div>
        </div>
        <ul class="network-visual__legend" aria-label="Relationship color legend">
          {Object.entries(categoryLabels).map(([key, label]) => (
            <li class={'network-legend--' + key}>{label}</li>
          ))}
        </ul>
        <p id="network-graph-status" role="status" aria-live="polite">Loading relationship graph…</p>
        <div id="network-canvas" role="img" aria-label="Interactive character relationship graph"></div>
      </section>
      <p class="network-graph-error" id="network-graph-error" role="status" hidden>The interactive graph could not be loaded. All historical connections remain available in the relationship cards below.</p>

      <div class="network-grid" id="network-grid">
        {characterRelationships.map((relation) => {
          const a = byId.get(relation.a);
          const b = byId.get(relation.b);
          if (!a || !b) throw new Error('Unknown character in relationship explorer');
          const title = chapterNames.get(relation.chapterId);
          if (!title) throw new Error('Unknown chapter in relationship explorer');
          return (
            <article
              class="network-edge"
              data-network-edge
              data-a={relation.a}
              data-b={relation.b}
              data-category={relation.category}
              data-label-a={relation.labelForA}
              data-label-b={relation.labelForB}
            >
              <div class="network-edge__head">
                <span>{categoryLabels[relation.category]}</span>
                <span class="network-edge__relation" data-network-label>{relation.labelForA}</span>
              </div>
              <div class="network-edge__person" data-network-person-a>
                <a href={withBase('characters/' + a.id + '/')}>{a.name} ↗</a>
                <button type="button" hidden data-network-focus={a.id} aria-label={'Focus relationship network on ' + a.name}>Focus on {a.name}</button>
              </div>
              <div class="network-edge__person" data-network-person-b>
                <a href={withBase('characters/' + b.id + '/')}>{b.name} ↗</a>
                <button type="button" hidden data-network-focus={b.id} aria-label={'Focus relationship network on ' + b.name}>Focus on {b.name}</button>
              </div>
              <p>{relation.context}</p>
              <a class="network-edge__chapter" href={withBase('chapters/' + relation.chapterId + '/')}>Historical context: {title} →</a>
            </article>
          );
        })}
      </div>
      <p class="network-note">Only documented relationships appear in this atlas; shared chapter appearances do not create connections. Use Relationship cards for complete contextual descriptions.</p>
      <div class="network-crosslinks">
        <a class="text-link" href={withBase('characters/')}>All character profiles →</a>
        <a class="text-link" href={withBase('timeline/')}>Explore the historical timeline →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { initializeRelationshipGraph } from '../../scripts/relationship-graph';
  const root = document.querySelector<HTMLElement>('[data-relationship-explorer]');
  if (root) {
    const controls = root.querySelector<HTMLElement>('#network-controls');
    const select = root.querySelector<HTMLSelectElement>('#network-person');
    const type = root.querySelector<HTMLSelectElement>('#network-category');
    const reset = root.querySelector<HTMLButtonElement>('#network-reset');
    const focus = root.querySelector<HTMLElement>('#network-focus');
    const name = root.querySelector<HTMLElement>('#network-focus-name');
    const count = root.querySelector<HTMLElement>('#network-count');
    const profile = root.querySelector<HTMLAnchorElement>('#network-profile');
    const empty = root.querySelector<HTMLElement>('#network-empty');
    const edges = Array.from(root.querySelectorAll<HTMLElement>('[data-network-edge]'));

    if (controls && select && type && reset && focus && name && count && profile && empty) {
      const validPeople = new Set(Array.from(select.options, (option) => option.value));
      const validCategories = new Set(Array.from(type.options, (option) => option.value));
      const restoreFromUrl = () => {
        const params = new URLSearchParams(window.location.search);
        const requested = params.get('person');
        const category = params.get('type');
        select.value = requested && validPeople.has(requested) ? requested : select.options[0]?.value ?? '';
        type.value = category && validCategories.has(category) ? category : '';
      };
      restoreFromUrl();
      const initial = select.value;
      const base = profile.href.slice(0, profile.href.lastIndexOf('/') + 1)
        .replace(/[^/]+\/$/, '');
      const update = (persist = false) => {
        const person = select.value;
        const category = type.value;
        const selected = select.selectedOptions[0];
        name.textContent = selected?.textContent ?? '';
        profile.href = base + encodeURIComponent(person) + '/';
        let visible = 0;
        for (const edge of edges) {
          const isA = edge.dataset.a === person;
          const isB = edge.dataset.b === person;
          const matches = (isA || isB) && (!category || edge.dataset.category === category);
          edge.hidden = !matches;
          if (!matches) continue;
          visible++;
          const a = edge.querySelector<HTMLElement>('[data-network-person-a]');
          const b = edge.querySelector<HTMLElement>('[data-network-person-b]');
          if (a) a.hidden = isA;
          if (b) b.hidden = isB;
          const label = edge.querySelector<HTMLElement>('[data-network-label]');
          if (label) label.textContent = isA ? (edge.dataset.labelA ?? '') : (edge.dataset.labelB ?? '');
        }
        count.textContent = visible + ' direct ' + (visible === 1 ? 'connection' : 'connections') + ' shown';
        empty.hidden = visible !== 0;
        if (persist) {
          const url = new URL(window.location.href);
          url.searchParams.set('person', person);
          if (category) url.searchParams.set('type', category);
          else url.searchParams.delete('type');
          if (url.href !== window.location.href) {
            window.history.pushState(null, '', url.pathname + url.search + url.hash);
          }
        }
        root.dispatchEvent(new CustomEvent('relationship:change'));
      };
      select.addEventListener('change', () => update(true));
      type.addEventListener('change', () => update(true));
      reset.addEventListener('click', () => { select.value = initial; type.value = ''; update(true); select.focus(); });
      window.addEventListener('popstate', () => { restoreFromUrl(); update(false); });
      root.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest<HTMLButtonElement>('[data-network-focus]');
        if (!button) return;
        const person = button.dataset.networkFocus;
        if (person && Array.from(select.options).some((option) => option.value === person)) {
          select.value = person;
          update(true);
          select.focus();
        }
      });
      for (const button of root.querySelectorAll<HTMLButtonElement>('[data-network-focus]')) {
        button.hidden = false;
      }
      controls.hidden = false;
      focus.hidden = false;
      update(false);
      void initializeRelationshipGraph(root);
    }
  }
</script>
