
---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';

import HistoricalCard from '../../components/HistoricalCard.astro';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');

  return chapters.map((chapter) => ({
    params: { id: chapter.id },
    props: { chapter },
  }));
}

const { chapter } = Astro.props as {
  chapter: CollectionEntry<'chapters'>;
};

const { Content } = await render(chapter);
---

<BaseLayout
  title={chapter.data.title}
  description={chapter.data.subtitle}
>
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">
        Historical Chapter {String(chapter.data.order).padStart(2, '0')}
        · {chapter.data.plane}
      </p>

      <h1>{chapter.data.title}</h1>
      <p>{chapter.data.subtitle}</p>
    </div>
  </section>

  <section class="section-spacing">
    <div class="page-shell article-column">
      <a
        href={withBase(`timeline/#${chapter.data.eraId}`)}
        class="text-link"
      >
        ← Return to timeline
      </a>

      <div class="chapter-publications">
        <p class="eyebrow">Related Expansions</p>

        <ul>
          {chapter.data.relatedSets.map((set) => (
            <li>{set.name} ({set.year})</li>
          ))}
        </ul>
      </div>

      <article class="chapter-prose">
        <Content />
      </article>

{
  chapter.data.cards.length > 0 && (
    <section
      class="chapter-cards"
      aria-labelledby="chapter-cards-heading"
    >
      <p class="eyebrow">
        Historical Artifacts
      </p>

      <h2 id="chapter-cards-heading">
        The Cards Behind the History
      </h2>

      <p class="chapter-cards__intro">
        These cards illustrate important characters,
        conflicts, and moments from this chapter.
      </p>

      <div class="historical-card-grid">
        {chapter.data.cards.map((card) => (
          <HistoricalCard card={card} />
        ))}
      </div>
    </section>
  )
}

    </div>
  </section>
</BaseLayout>
