
---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/paths';

import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterToc from '../../components/ChapterToc.astro';
import ChapterArtworkTrail from '../../components/ChapterArtworkTrail.astro';
import ChapterReadingControls from '../../components/ChapterReadingControls.astro';
import ChapterSources from '../../components/ChapterSources.astro';
import ChapterSwitcher from '../../components/ChapterSwitcher.astro';
import ChapterHistoryPaths from '../../components/ChapterHistoryPaths.astro';
import ChapterEntityConnections from '../../components/ChapterEntityConnections.astro';
import ChapterContextRail from '../../components/ChapterContextRail.astro';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');

  return chapters.map((chapter) => ({
    params: { id: chapter.id },
    props: { chapter },
  }));
}

const { chapter } = Astro.props as {
  chapter: CollectionEntry<'chapters'>;
};

// Render the chapter and collect its headings.
const { Content, headings } = await render(chapter);

// Determine the reading order from authored chapters.
const chapters = (await getCollection('chapters')).sort(
  (a, b) =>
    a.data.order - b.data.order ||
    a.id.localeCompare(b.id)
);

const currentIndex = chapters.findIndex(
  (entry) => entry.id === chapter.id
);

const previousChapter = chapters[currentIndex - 1];
const nextChapter = chapters[currentIndex + 1];
---

<BaseLayout
  title={chapter.data.title}
  description={chapter.data.subtitle}
  printingId={chapter.data.cardIds[0].id}
>
  <div class="chapter-theme" data-era-theme={chapter.id}>
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">
        Historical Chapter {String(chapter.data.order).padStart(2, '0')}
        · {chapter.data.plane}
      </p>

      <h1>{chapter.data.title}</h1>
      <p>{chapter.data.subtitle}</p>
      <dl class="chapter-banner-facts">
        <div><dt>Story period</dt><dd>{chapter.data.chronology.storyPeriod}</dd></div>
        <div><dt>Related set releases</dt><dd>{chapter.data.relatedSets.map(set => set.year).filter((year, index, years) => years.indexOf(year) === index).join(' · ')}</dd></div>
        <div><dt>In this chapter</dt><dd>{headings.filter(heading => heading.depth === 2).length} sections · {chapter.data.cardIds.length} illustrated references</dd></div>
      </dl>
      <a class="chapter-banner__start" href="#chapter-reader">Begin reading <span aria-hidden="true">↓</span></a>
    </div>
  </section>

<div class="chapter-switcher-band">
  <div class="page-shell">
    <ChapterSwitcher chapters={chapters} activeId={chapter.id} />
  </div>
</div>

  <section id="chapter-reader" class="chapter-reader" data-chapter-reading-root tabindex="-1" aria-label="Chapter reading content">
    <div class="page-shell chapter-reading-grid">

      <!-- Chapter navigation sidebar -->
      <aside class="chapter-reading-sidebar">
        <ChapterToc
          headings={headings}
          hasSources={chapter.data.sources.length > 0}
        />
      </aside>

      <!-- Main reading column -->
      <div class="chapter-reading-content">

        <a
          class="text-link"
          href={withBase(`timeline/#${chapter.data.eraId}`)}
        >
          ← Return to timeline
        </a>

        <p class="chapter-reader__context">Chapter {String(chapter.data.order).padStart(2, '0')} · {chapter.data.title}</p>

        <div class="chapter-toolbar">
        <details class="chapter-settings" data-chapter-settings hidden>
          <summary aria-label="Aa Reading preferences"><span aria-hidden="true">Aa</span> Reading preferences <span aria-hidden="true">⌄</span></summary>
          <ChapterReadingControls />
        </details>

        <details class="chapter-publications">
          <summary>
            <span>Related expansions</span>
            <span class="chapter-publications__count">{chapter.data.relatedSets.length} publications <span aria-hidden="true">⌄</span></span>
          </summary>
          <ul>
            {chapter.data.relatedSets.map((set) => (
              <li>{set.name} ({set.year})</li>
            ))}
          </ul>
        </details>

        </div>

        <!-- A progressive, opt-in guide to the existing illustrated moments. -->
        <ChapterArtworkTrail />

        <!-- Historical narrative -->
        <article class="chapter-prose">
          <Content />
        </article>

        <!-- Historical references -->
        <ChapterSources sources={chapter.data.sources} />

        <!-- Curated historical continuity, separate from sequential navigation. -->
        <ChapterHistoryPaths chapterId={chapter.id} chapters={chapters} />
        <ChapterEntityConnections chapterId={chapter.id} chapters={chapters} />

        <!-- Reading navigation -->
        <nav
          class="chapter-pagination"
          aria-label="Chapter navigation"
        >
          {previousChapter && (
            <a
              class="chapter-pagination__link"
              href={withBase(
                `chapters/${previousChapter.id}/#chapter-reader`
              )}
            >
              <span>← Previous chapter</span>
              <strong>{previousChapter.data.title}</strong>
            </a>
          )}

          {nextChapter && (
            <a
              class="chapter-pagination__link"
              href={withBase(
                `chapters/${nextChapter.id}/#chapter-reader`
              )}
            >
              <span>Next chapter →</span>
              <strong>{nextChapter.data.title}</strong>
            </a>
          )}

          <a
            class="chapter-pagination__link"
            href={withBase('timeline/')}
          >
            <span>Explore more history</span>
            <strong>Complete historical timeline →</strong>
          </a>
        </nav>

      </div>
      <ChapterContextRail chapterId={chapter.id}
        previousChapter={previousChapter ? { id: previousChapter.id, title: previousChapter.data.title } : undefined} />
    </div>
  </section>
  </div>
  <script>
    import { setupLivingChapterReveals } from '../../utils/living-chapters.mjs';
    setupLivingChapterReveals(document.querySelector('.chapter-theme'));
  </script>
</BaseLayout>
