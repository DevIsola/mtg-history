---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';

const entries = (await getCollection('glossary')).sort((a, b) => a.data.term.localeCompare(b.data.term));
const chapters = new Map((await getCollection('chapters')).map(({ id, data }) => [id, data.title]));
---

<BaseLayout title="Lore glossary" description="Definitions of recurring Magic: The Gathering history concepts, with links to the chapters where they matter.">
  <section class="page-banner">
    <div class="page-shell">
      <p class="eyebrow eyebrow--light">Reading companion</p>
      <h1>Lore <em>glossary.</em></h1>
      <p>Concise explanations of people, places and concepts encountered across the historical chapters.</p>
    </div>
  </section>
  <section class="section-spacing" aria-labelledby="glossary-heading">
    <div class="page-shell">
      <div class="glossary-intro">
        <h2 id="glossary-heading" class="section-title">Concepts across <em>the Multiverse.</em></h2>
        <p>Definitions are editorial summaries. Follow the chapter link for historical context and supporting sources.</p>
      </div>
      <ol class="glossary-grid">
        {entries.map((entry) => (
          <li class="glossary-entry" id={entry.id}>
            <h3>{entry.data.term}</h3>
            <p class="glossary-entry__summary">{entry.data.summary}</p>
            <p>{entry.data.details}</p>
            <a class="text-link" href={withBase(`chapters/${entry.data.chapterId.id}/#chapter-reader`)}>
              Read in {chapters.get(entry.data.chapterId.id)} →
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  .glossary-intro { max-width: 64ch; margin-bottom: 2.5rem; }
  .glossary-intro > p { margin-top: 0.75rem; color: var(--ink-soft); line-height: 1.7; }
  .glossary-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 310px), 1fr)); gap: 1.2rem; }
  .glossary-entry { background: var(--paper-white); border: 1px solid var(--line); padding: 1.6rem; scroll-margin-top: calc(var(--site-header-height) + 1.5rem); }
  .glossary-entry:target { outline: 3px solid var(--gold); outline-offset: 3px; }
  .glossary-entry h3 { font-family: var(--font-display); font-size: 1.5rem; }
  .glossary-entry p { margin-block: 0.8rem; line-height: 1.65; color: var(--ink-soft); }
  .glossary-entry__summary { font-weight: 600; color: var(--ink) !important; }
  .glossary-entry .text-link { display: inline-block; margin-top: 0.6rem; font-size: 0.88rem; }
</style>
